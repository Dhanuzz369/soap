---
import { categoryPicture } from '../lib/product-image';
import { getProductsByCategory } from '../lib/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardGrid from '../components/CardGrid.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { useI18n } from '../i18n/page';

const { lang, ui, lp, fmt } = useI18n(Astro.url);
const T = ui.productsIndex;
const groups = await getProductsByCategory(lang);
const total = groups.reduce((n, g) => n + g.products.length, 0);
const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.common.products, url: lp('/products/') },
];
---

<BaseLayout
  title={T.title}
  description={fmt(T.description, { n: total })}
  path="/products/"
  breadcrumbs={breadcrumbs}
  dark
>
  <PageHero
    breadcrumbs={breadcrumbs}
    l1={T.l1}
    l2={T.l2}
    lead={fmt(T.lead, { n: total })}
    size="product"
    media={{
      src: '/images/renders/range-cutout.webp',
      srcset: '/images/renders/range-cutout-800.webp 800w, /images/renders/range-cutout.webp 1600w',
      sizes: '(max-width: 759px) 100vw, 54vw',
      width: 1600,
      height: 1280,
      alt: ui.common.rangeAlt,
      mode: 'bleed',
      cutout: true,
    }}
  >
    <div class="ph-actions">
      <a class="btn btn--light" href={lp('/contact/')}>{ui.common.requestQuote}</a>
      <a class="link-arrow" href="#hsn">{T.hsnLink} <span class="arr" aria-hidden="true">↓</span></a>
    </div>
  </PageHero>

  <nav class="wrap sec" aria-label={T.rangesNav}>
    <ul class="cat-strip">
      {
        groups.map((g, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a class="cat-chip" href={`#c-${g.category.data.slug}`}>
              <span class="cat-chip-media">
                <img
                  src={categoryPicture(g.category.data.slug).src}
                  width="760"
                  height="950"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="cat-chip-title">
                {g.category.data.title}
                <span class="cat-chip-meta">
                  {fmt(ui.home.tileMeta, { n: g.products.length, hsn: g.category.data.hsnRange })}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((g) => (
      <section class="wrap chapter" id={`c-${g.category.data.slug}`} aria-labelledby={`c-${g.category.data.slug}-h`}>
        <div class="sec-head" data-reveal>
          <div>
            <h2 id={`c-${g.category.data.slug}-h`}>
              <a href={lp(`/categories/${g.category.data.slug}/`)}>{g.category.data.title}</a>
            </h2>
            <p>{g.category.data.summary}</p>
          </div>
          <a class="link-arrow" href={lp(`/categories/${g.category.data.slug}/`)}>
            {T.rangeFull} <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
        <CardGrid products={g.products} />
      </section>
    ))
  }

  <section class="wrap sec hsn-sec" id="hsn" aria-labelledby="hsn-h">
    <div class="sec-head" data-reveal>
      <div>
        <h2 id="hsn-h">{T.hsnH}</h2>
        <p>{T.hsnText}</p>
      </div>
    </div>
    <div class="spec-wrap" data-reveal style="--i: 1">
      <table class="spec spec--cols">
        <caption>{T.hsnCaption}</caption>
        <thead>
          <tr><th scope="col">{T.colProduct}</th><th scope="col">{T.colRange}</th><th scope="col">{T.colHsn}</th></tr>
        </thead>
        <tbody>
          {
            groups.flatMap((g) =>
              g.products.map((p) => (
                <tr>
                  <th scope="row"><a href={lp(`/products/${p.data.slug}/`)}>{p.data.title}</a></th>
                  <td data-label={T.colRange}>{g.category.data.title}</td>
                  <td class="num" data-label={T.colHsn}>{p.data.hsn}</td>
                </tr>
              )),
            )
          }
        </tbody>
      </table>
    </div>
  </section>

  <QuoteCard />
</BaseLayout>
