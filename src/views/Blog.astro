---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GuideRows from '../components/GuideRows.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { getPosts } from '../lib/blog';
import { useI18n } from '../i18n/page';
import { itemListJsonLd, buildKeywords, absoluteUrl } from '../lib/seo';
import { ogCard } from '../lib/product-image';

const { lang, ui, lp } = useI18n(Astro.url);
const B = ui.blogIndex;
const posts = await getPosts(lang);
const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.common.blog, url: lp('/blog/') },
];
---

<BaseLayout
  title={B.title}
  description={B.description}
  path="/blog/"
  ogImage={ogCard(`${lang}/blog.png`)}
  keywords={buildKeywords(ui.seo.keywords.blog)}
  pageType="CollectionPage"
  mainEntity={`${absoluteUrl(lp('/blog/'))}#itemlist`}
  jsonLd={[itemListJsonLd(lp('/blog/'), B.title, posts.map((p) => ({ name: p.data.title, url: lp(`/blog/${p.id}/`) })))]}
  breadcrumbs={breadcrumbs}
  dark
>
  <PageHero
    breadcrumbs={breadcrumbs}
    l1={B.l1}
    l2={B.l2}
    lead={B.lead}
    media={{ src: '/images/found/neem-plate.webp', width: 1100, height: 682, alt: '', mode: 'plate' }}
  />

  <GuideRows posts={posts} heading={B.latest} id="posts" large />

  <QuoteCard />
</BaseLayout>
