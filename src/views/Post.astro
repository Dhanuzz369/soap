---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero, { type HeroMedia } from '../components/PageHero.astro';
import CardGrid from '../components/CardGrid.astro';
import Faq from '../components/Faq.astro';
import QuoteCard from '../components/QuoteCard.astro';
import EntryBody from '../components/EntryBody.astro';
import { readingMinutes, fmtDate, type BlogEntry } from '../lib/blog';
import type { ProductEntry } from '../lib/products';
import { useI18n } from '../i18n/page';
import { articleJsonLd, faqJsonLd, buildKeywords, absoluteUrl } from '../lib/seo';
import { splitPostTitle } from '../lib/heading';
import { productPicture, productImagePath, ogCard } from '../lib/product-image';
import { shapeFor } from '../lib/pack-shapes';

interface Props {
  post: BlogEntry;
  related: ProductEntry[];
}
const { post, related } = Astro.props;
const { lang, info, ui, lp, fmt, lower } = useI18n(Astro.url);
const d = post.data;
const path = `/blog/${post.id}/`;
const url = lp(path);
const faqs = d.faqs ?? [];
const iso = d.date.toISOString().slice(0, 10);
// "{date} · {minutes} · GoodBiz Hygiene": the date is a <time> element, the rest is text around it.
const [metaBefore, metaAfter = ''] = ui.post.meta.split('{date}');
const metaVars = { minutes: fmt(ui.common.minRead, { n: readingMinutes(post.body ?? '') }) };
// "Last reviewed {date}": shown when the guide has an `updated` date (its facts and sources re-checked).
const [revBefore, revAfter = ''] = ui.post.reviewed.split('{date}');
const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.common.blog, url: lp('/blog/') },
  { name: d.title, url },
];
const t = splitPostTitle(d.title);
// The share image: the card of the first product the guide is about (npm run og), else its photo.
const leadSlug = d.relatedProducts[0];
const share = (leadSlug && (ogCard(`products/${leadSlug}.jpg`) ?? productImagePath(leadSlug))) || undefined;
const images = [share, ...related.map((p) => productImagePath(p.data.slug))].filter((x, i, a): x is string => !!x && a.indexOf(x) === i).slice(0, 3);
const keywords = buildKeywords(d.tags, {}, [...related.map((p) => p.data.keyword ?? lower(p.data.title)), ...ui.seo.keywords.post]);
const lead = related[0];
const pic = lead ? productPicture(lead.data.slug, shapeFor(lead.data.slug, lead.data.category.id), lead.data.category.id) : undefined;
const media: HeroMedia | undefined =
  pic && pic.kind === 'render'
    ? {
        src: pic.src,
        srcset: pic.srcset,
        sizes: '(max-width: 759px) 100vw, 54vw',
        width: pic.width,
        height: pic.height,
        alt: fmt(ui.common.renderAlt, { name: lead!.data.title, nameLower: lower(lead!.data.title) }),
        mode: 'bleed',
        cutout: true,
      }
    : undefined;
---

<BaseLayout
  title={d.metaTitle ?? d.title}
  description={d.description}
  path={path}
  ogImage={share}
  keywords={keywords}
  mainEntity={`${absoluteUrl(url)}#article`}
  article={{ published: d.date, modified: d.updated, tags: d.tags }}
  breadcrumbs={breadcrumbs}
  jsonLd={[
    articleJsonLd({
      title: d.title,
      description: d.description,
      date: d.date,
      updated: d.updated,
      url,
      type: 'BlogPosting',
      inLanguage: info.hreflang,
      image: images,
      keywords: d.tags,
    }),
    ...(faqs.length ? [faqJsonLd(faqs, info.hreflang, url)] : []),
  ]}
  dark
>
  <PageHero breadcrumbs={breadcrumbs} l1={t.l1} l2={t.l2} size="post" media={media}>
    <p class="ph-meta">
      {fmt(metaBefore, metaVars)}<time datetime={iso}>{fmtDate(d.date, lang)}</time>{fmt(metaAfter, metaVars)}
    </p>
    {
      d.updated && (
        <p class="ph-meta ph-reviewed">
          {revBefore}<time datetime={d.updated.toISOString().slice(0, 10)}>{fmtDate(d.updated, lang)}</time>{revAfter}
        </p>
      )
    }
    <p class="ph-lead">{d.description}</p>
  </PageHero>

  <div class="wrap sec post-layout">
    <article class="prose post-body">
      <EntryBody entry={post} />
    </article>
  </div>

  {faqs.length > 0 && <Faq faqs={faqs} heading={ui.post.quickAnswers} id="post-faq" split />}

  {
    related.length > 0 && (
      <section class="wrap sec" aria-labelledby="rel-h">
        <div class="sec-head" data-reveal>
          <h2 id="rel-h">{ui.post.relatedH}</h2>
          <a class="link-arrow" href={lp('/blog/')}>
            {ui.common.allGuides} <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
        <CardGrid products={related} />
      </section>
    )
  }

  <QuoteCard heading={ui.post.quoteH} text={ui.post.quoteText} />
</BaseLayout>
