---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteHero from '../components/RouteHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Faq from '../components/Faq.astro';
import Registrations from '../components/Registrations.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { faqJsonLd, howToJsonLd, buildKeywords } from '../lib/seo';
import { ogCard } from '../lib/product-image';
import { useI18n } from '../i18n/page';

const { lang, info, ui, lp, fmt } = useI18n(Astro.url);
const E = ui.exportProcess;
const t = ui.terms;

const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.header.nav.exportProcess, url: lp('/export-process/') },
];

const steps = E.steps.map((s) => ({ name: s.name, text: fmt(s.text, t) }));
const documents = E.documents;
const faqs = E.faqs.map((f) => ({ q: fmt(f.q, t), a: fmt(f.a, t) }));
---

<BaseLayout
  title={E.title}
  description={E.description}
  path="/export-process/"
  ogImage={ogCard(`${lang}/export-process.png`)}
  keywords={buildKeywords(ui.seo.keywords.exportProcess)}
  breadcrumbs={breadcrumbs}
  jsonLd={[
    howToJsonLd({ url: lp('/export-process/'), name: E.howToName, description: E.processIntro, inLanguage: info.hreflang, steps, anchor: 'steps' }),
    faqJsonLd(faqs, info.hreflang, lp('/export-process/')),
  ]}
  dark
>
  <RouteHero breadcrumbs={breadcrumbs} />

  <section class="wrap sec" aria-labelledby="terms-h">
    <div class="sec-head" data-reveal>
      <h2 id="terms-h">{E.termsH}</h2>
    </div>
    <dl class="facts" data-reveal style="--i: 1">
      <div><dt>{E.termsIncoterms}</dt><dd>{t.incoterms}</dd></div>
      <div><dt>{E.termsPort}</dt><dd>{t.port}</dd></div>
      <div><dt>{E.termsLead}</dt><dd>{t.leadTime}</dd></div>
    </dl>
  </section>

  <div id="steps">
    <ProcessSteps id="steps-p" l1={E.processL1} l2={E.processL2} intro={E.processIntro} steps={steps} photo />
  </div>

  <section class="wrap sec split" aria-labelledby="docs-h">
    <div class="split-head" data-reveal>
      <h2 id="docs-h">{E.docsH}</h2>
      <p>{E.docsText}</p>
    </div>
    <ul class="chips chips--lg" data-reveal style="--i: 1">
      {documents.map((d) => <li class="chip">{d}</li>)}
    </ul>
  </section>

  <section class="wrap sec split" aria-labelledby="regs-h">
    <div class="split-head" data-reveal>
      <h2 id="regs-h">{ui.registrations.heading}</h2>
      <p>{ui.registrations.aboutText}</p>
    </div>
    <div data-reveal style="--i: 1">
      <Registrations variant="full" />
    </div>
  </section>

  <Faq faqs={faqs} heading={E.faqH} split />

  <QuoteCard />
</BaseLayout>
