---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabelHero from '../components/LabelHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Faq from '../components/Faq.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { faqJsonLd } from '../lib/seo';
import { useI18n } from '../i18n/page';

const { info, ui, lp, fmt } = useI18n(Astro.url);
const L = ui.privateLabel;
const t = ui.terms;

const options = L.options;
const steps = L.steps.map((s) => ({ name: s.name, text: fmt(s.text, t) }));
const faqs = L.faqs.map((f) => ({ q: fmt(f.q, t), a: fmt(f.a, t) }));
const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.header.nav.privateLabel, url: lp('/private-label/') },
];
---

<BaseLayout
  title={L.title}
  description={L.description}
  path="/private-label/"
  breadcrumbs={breadcrumbs}
  jsonLd={[faqJsonLd(faqs, info.hreflang)]}
  dark
>
  <LabelHero breadcrumbs={breadcrumbs} />

  <section class="wrap sec split" aria-labelledby="pl-options-h">
    <div class="split-head" data-reveal>
      <h2 id="pl-options-h">{L.optionsH}</h2>
      <p>{L.optionsText}</p>
    </div>
    <ul class="rows">
      {
        options.map((o, i) => (
          <li class="row" data-reveal style={`--i: ${i % 3}`}>
            <h3>{o.title}</h3>
            <p>{o.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <ProcessSteps
    id="pl-process"
    l1={L.processL1}
    l2={L.processL2}
    intro={L.processIntro}
    steps={steps}
    photo
    link={{ href: lp('/export-process/'), label: ui.common.exportProcessFull }}
  />

  <Faq faqs={faqs} heading={L.faqH} split />

  <QuoteCard heading={L.quoteH} text={L.quoteText} />
</BaseLayout>
