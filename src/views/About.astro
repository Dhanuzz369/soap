---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCard from '../components/QuoteCard.astro';
import site from '../config/site';
import { getProductsByCategory } from '../lib/products';
import { useI18n } from '../i18n/page';
import { buildKeywords } from '../lib/seo';
import { ogCard } from '../lib/product-image';
import Registrations from '../components/Registrations.astro';
import QuickFacts from '../components/QuickFacts.astro';

const { lang, ui, lp, fmt } = useI18n(Astro.url);
const A = ui.about;
const parent = { parent: site.parentName };
const groups = await getProductsByCategory(lang);
const f = site.facts;
const facts = [
  f.city && { label: A.basedIn, value: f.city },
  f.founded && { label: A.founded, value: f.founded },
  f.iec && { label: A.iec, value: f.iec },
].filter((x): x is { label: string; value: string } => !!x);
const breadcrumbs = [
  { name: ui.common.home, url: lp('/') },
  { name: ui.header.nav.about, url: lp('/about/') },
];
---

<BaseLayout
  title={A.title}
  description={A.description}
  path="/about/"
  ogImage={ogCard(`${lang}/about.png`)}
  keywords={buildKeywords(ui.seo.keywords.about)}
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
  dark
>
  <PageHero
    breadcrumbs={breadcrumbs}
    l1={A.l1}
    l2={fmt(A.l2, parent)}
    lead={fmt(A.lead, parent)}
    media={{ src: '/images/found/neem-plate.webp', width: 1100, height: 682, alt: '', mode: 'plate' }}
  />

  <section class="wrap sec split" aria-labelledby="what-h">
    <div class="split-head" data-reveal>
      <h2 id="what-h">{A.whatH}</h2>
    </div>
    <div class="prose" data-reveal style="--i: 1">
      <p>{A.what1}</p>
      <p>{A.what2}</p>
    </div>
  </section>

  <section class="wrap sec split" id="how-we-vet" aria-labelledby="vet-h">
    <div class="split-head" data-reveal>
      <h2 id="vet-h">{A.vetH}</h2>
      <p>{A.vetLead}</p>
    </div>
    <ol class="rows vet-rows">
      {
        A.vetSteps.map((s, i) => (
          <li class="row" data-reveal style={`--i: ${i % 3}`}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <QuickFacts />

  <nav class="wrap sec" aria-labelledby="ranges-h">
    <div class="sec-head" data-reveal>
      <h2 id="ranges-h">{A.rangesH}</h2>
      <a class="link-arrow" href={lp('/products/')}>{ui.common.allProducts} <span class="arr" aria-hidden="true">↗</span></a>
    </div>
    <ul class="cat-strip">
      {
        groups.map((g, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a class="cat-chip" href={lp(`/categories/${g.category.data.slug}/`)}>
              <span class="cat-chip-media">
                <img src={`/images/renders/category-${g.category.data.slug}.webp`} width="760" height="950" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="cat-chip-title">
                {g.category.data.title}
                <span class="cat-chip-meta">{fmt(ui.home.tileMeta, { n: g.products.length, hsn: g.category.data.hsnRange })}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="wrap sec split" aria-labelledby="family-h">
    <div class="split-head" data-reveal>
      <h2 id="family-h">{fmt(A.familyH, parent)}</h2>
    </div>
    <div class="prose" data-reveal style="--i: 1">
      <p>
        {fmt(A.familyText, parent)}
        {f.parentUrl && <> {A.visit} <a href={f.parentUrl}>{site.parentName}</a>.</>}
        {f.agroUrl && <> {A.visit} <a href={f.agroUrl}>GoodBiz Agro</a>.</>}
      </p>
      {
        facts.length > 0 && (
          <dl class="facts" style="margin-top:32px">
            {facts.map((x) => (
              <div>
                <dt>{x.label}</dt>
                <dd>{x.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section class="wrap sec split" aria-labelledby="regs-h">
    <div class="split-head" data-reveal>
      <h2 id="regs-h">{ui.registrations.heading}</h2>
      <p>{ui.registrations.aboutText}</p>
    </div>
    <div data-reveal style="--i: 1">
      <Registrations variant="full" />
    </div>
  </section>

  <QuoteCard />
</BaseLayout>
