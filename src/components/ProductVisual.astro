---
/**
 * ProductVisual
 * Renders /images/products/<slug>.webp when that file exists at build time.
 * Otherwise it draws a flat SVG pack silhouette, chosen by product (then by category),
 * tinted from the category's chapter colours (see tokens.css [data-cat]).
 */
import { shapes, shapeFor } from '../lib/pack-shapes';
import { productImagePath } from '../lib/product-image';

interface Props {
  slug: string;
  title: string;
  category: string;
  size: 'card' | 'hero';
}

const { slug, title, category, size } = Astro.props;

const imgSrc = productImagePath(slug);
const hasImage = !!imgSrc;

const shape = shapeFor(slug, category);

const svg = shapes[shape];
---

<figure class:list={['pv', `pv--${size}`]} data-cat={category} data-shape={hasImage ? 'photo' : shape}>
  {
    hasImage ? (
      <img
        src={imgSrc}
        alt={title}
        width={size === 'hero' ? 1200 : 600}
        height={size === 'hero' ? 1200 : 600}
        loading={size === 'hero' ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <svg viewBox="0 0 240 240" role="img" aria-label={`${title} (illustration)`} set:html={`<title>${title.replace(/[<&>]/g, '')}</title>${svg}`} />
    )
  }
  {size === 'hero' && !hasImage && <figcaption class="pv-caption">{title}</figcaption>}
</figure>
