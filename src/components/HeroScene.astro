---
/**
 * HeroScene: the range as a glossy cut-out object (glossy & motion audit, Floria's hero object).
 *
 * The transparent still `range-cutout.webp` (`npm run renders`) is the LCP element (preloaded by
 * the home page). CSS pops it in on load (opacity, scale .9 → 1.05, rotate -8° → 0, 1.4s,
 * cubic-bezier(.16,1,.3,1), 300ms delay) and drifts it with scroll (`animation-timeline:
 * scroll()`, or src/scripts/scroll-fallback.ts). The pop is a transition started once the image
 * has painted, so the cut-out stays the LCP element. It is absolutely positioned and sized by its
 * aspect ratio before it loads (CLS 0), and overflows into the next section.
 *
 * A tiny loader checks reduced motion, WebGL and data saver, then imports the Three.js scene only
 * after the page has loaded and the visitor first interacts (pointer, touch, scroll or key), once
 * the object is visible and the browser is idle. The canvas sits in the same transformed box and
 * renders the same framing at rest, so it lands on the still; the two then cross-fade, and
 * scrolling fans the packs apart.
 */
import Bubbles from './Bubbles.astro';
import { useI18n } from '../i18n/page';
const { ui } = useI18n(Astro.url);
---

<script is:inline>
  // Before the first paint: hold the object in its starting pose until it has painted (see home.css).
  document.documentElement.classList.add('hero-js');
</script>
<div class="hero-object" data-drift="hero">
  <div class="hero-object-pop">
    <img
      class="hero-cutout"
      src="/images/renders/range-cutout.webp"
      srcset="/images/renders/range-cutout-800.webp 800w, /images/renders/range-cutout.webp 1600w"
      sizes="(max-width: 759px) 100vw, 62vw"
      width="1600"
      height="1280"
      alt={ui.common.heroAlt}
      fetchpriority="high"
      decoding="async"
    />
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
  </div>
</div>
<script is:inline>
  // Pop the object in once the cut-out has painted (two frames after load), or after 2.5s anyway.
  (function () {
    var pop = document.querySelector('.hero-object-pop');
    var img = pop && pop.querySelector('img');
    if (!pop || !img) return;
    var done = false;
    var go = function () {
      if (done) return;
      done = true;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          pop.classList.add('is-in');
        });
      });
    };
    if (img.complete) go();
    else {
      img.addEventListener('load', go, { once: true });
      img.addEventListener('error', go, { once: true });
    }
    setTimeout(go, 2500);
  })();
</script>
<Bubbles set="hero" />

<script>
  import { shouldRun3D, detectHeroEnv } from '../scripts/hero-env';
  import '../scripts/scroll-fallback';

  const box = document.querySelector<HTMLElement>('.hero-object');
  const canvas = box?.querySelector<HTMLCanvasElement>('canvas');

  if (box && canvas && shouldRun3D(detectHeroEnv())) {
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 3000 }) : setTimeout(cb, 800);

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      import('../scripts/hero-scene')
        .then(({ mountHero }) => {
          const dispose = mountHero(canvas);
          window.addEventListener('pagehide', (e) => !e.persisted && dispose(), { once: true });
        })
        .catch(() => {
          /* the still stays */
        });
    };

    // The scene costs real main-thread time, so it waits for the visitor: the first pointer move,
    // touch, scroll or key after the page has loaded (until then, and without it, the still shows).
    const begin = () => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          idle(start);
        }
      });
      io.observe(box);
    };
    const events = ['pointermove', 'pointerdown', 'touchstart', 'scroll', 'keydown', 'wheel'] as const;
    const onFirst = () => {
      events.forEach((e) => window.removeEventListener(e, onFirst));
      begin();
    };
    const arm = () => events.forEach((e) => window.addEventListener(e, onFirst, { once: true, passive: true }));
    if (document.readyState === 'complete') arm();
    else window.addEventListener('load', arm, { once: true });
  }
</script>
