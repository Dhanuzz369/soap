---
/**
 * HeroScene: the range photographed in a dark studio (spec §14, restyle direction §1).
 * The pre-rendered still (`npm run renders`, the same scene at t = 0) paints first: it is the
 * LCP element and the fallback. A tiny loader checks reduced motion, WebGL and data saver, then
 * imports the Three.js scene only after the page has loaded and the visitor first interacts (pointer,
 * touch, scroll or key), once the stage is visible and the browser is idle; the canvas fades in over
 * the still. Both are cropped the same way, so the still simply comes alive.
 */
---

<div class="stage" data-hero-stage>
  <img
    class="stage-still"
    src="/images/renders/range-hero.webp"
    width="1600"
    height="1000"
    alt="Illustration of the GoodBiz Hygiene range in typical export packs: a dish wash bottle, a fabric softener jug, a spray cleaner, a hand wash pump, a detergent pouch, a raw-material drum, a jerrycan and soap bars"
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="stage-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { shouldRun3D, detectHeroEnv } from '../scripts/hero-env';

  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('canvas');

  if (stage && canvas && shouldRun3D(detectHeroEnv())) {
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 3000 }) : setTimeout(cb, 800);

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      import('../scripts/hero-scene')
        .then(({ mountHero }) => {
          const dispose = mountHero(canvas);
          window.addEventListener('pagehide', (e) => !e.persisted && dispose(), { once: true });
        })
        .catch(() => {
          /* the still stays */
        });
    };

    // The scene costs real main-thread time, so it waits for the visitor: the first pointer move,
    // touch, scroll or key after the page has loaded (until then, and without it, the still shows).
    const begin = () => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          idle(start);
        }
      });
      io.observe(stage);
    };
    const events = ['pointermove', 'pointerdown', 'touchstart', 'scroll', 'keydown', 'wheel'] as const;
    const onFirst = () => {
      events.forEach((e) => window.removeEventListener(e, onFirst));
      begin();
    };
    const arm = () => events.forEach((e) => window.addEventListener(e, onFirst, { once: true, passive: true }));
    if (document.readyState === 'complete') arm();
    else window.addEventListener('load', arm, { once: true });
  }
</script>
