---
/**
 * The dark numbered process: a sticky heading (italic second line), an intro, optionally the
 * Kochi port photograph and a link; on the right the steps in 01/02/03 circles that fill mint
 * as each reaches mid-screen (BaseLayout script, [data-step]).
 * Behind it, the neem leaves (a cut-out of the 1873 public-domain plate credited in the footer)
 * slide in from the left, masked to a soft oval, in lighten blend.
 */
import { foundPictures } from '../data/found-pictures';
import { useI18n } from '../i18n/page';

interface Props {
  l1: string;
  l2: string;
  intro: string;
  steps: { name: string; text: string }[];
  photo?: boolean;
  link?: { href: string; label: string };
  id?: string;
}
const { l1, l2, intro, steps, photo = false, link, id = 'process' } = Astro.props;
const { ui, fmt } = useI18n(Astro.url);
const port = foundPictures.find((p) => p.file.includes('kochi'))!;
---

<section class="process" aria-labelledby={`${id}-h`}>
  <img
    class="process-leaves"
    src="/images/found/neem-leaves.webp"
    srcset="/images/found/neem-leaves-600.webp 600w, /images/found/neem-leaves-900.webp 900w, /images/found/neem-leaves.webp 1100w"
    sizes="(max-width: 899.98px) 120vw, min(62vw, 980px)"
    width="1100"
    height="682"
    alt=""
    loading="lazy"
    decoding="async"
    data-reveal
  />
  <div class="wrap process-grid">
    <div class="process-head">
      <div class="process-sticky">
        <h2 id={`${id}-h`} data-reveal>{l1} <span class="serif-i">{l2}</span></h2>
        <p class="process-intro" data-reveal style="--i: 1">{intro}</p>
        {
          photo && (
            <figure class="process-photo" data-reveal style="--i: 2">
              <div class="process-photo-frame">
                <img
                  src="/images/found/kochi-port-night-600.webp"
                  srcset="/images/found/kochi-port-night-400.webp 400w, /images/found/kochi-port-night-600.webp 600w, /images/found/kochi-port-night-800.webp 800w, /images/found/kochi-port-night.webp 1200w"
                  sizes="(max-width: 520px) calc(100vw - 40px), 480px"
                  width="1200"
                  height="900"
                  alt={ui.common.portAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption>
                {fmt(ui.common.portCaption, { creator: port.creator, license: port.license })}
              </figcaption>
            </figure>
          )
        }
        {
          link && (
            <p data-reveal style="--i: 3">
              <a class="link-arrow process-link" href={link.href}>
                {link.label} <span class="arr" aria-hidden="true">→</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class={`step step--${(i % 3) + 1}`} data-step>
            <span class="step-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0') /* taste-skill-ignore: 01/02/03 circles, allowed by the direction */}
            </span>
            <div class="step-body">
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
