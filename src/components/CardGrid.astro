---
/**
 * Tall rounded product cards in a staggered grid. The column count is chosen so no row ends
 * with one lonely card (src/lib/card-grid.ts); a single gap is filled with a "mix in one
 * container" note that links to the enquiry form.
 */
import type { ProductEntry } from '../lib/products';
import ProductCard from './ProductCard.astro';
import { cardGrid } from '../lib/card-grid';
import { useI18n } from '../i18n/page';

interface Props {
  products: ProductEntry[];
  details?: boolean;
  noteText?: string;
}
const { ui, lp } = useI18n(Astro.url);
const { products, details = true, noteText = ui.cards.noteText } = Astro.props;
const g = cardGrid(products.length);
---

<ul class:list={['cards-stagger', `cards-stagger--${g.cols}`]}>
  {
    products.map((p, i) => (
      <li data-reveal style={`--i: ${i % g.cols}`}>
        <ProductCard product={p} details={details} />
      </li>
    ))
  }
  {
    g.note && (
      <li class="cards-note" data-reveal style={`--i: ${products.length % g.cols}`}>
        <p class="cards-note-h">{ui.cards.noteH}</p>
        <p>{noteText}</p>
        <a class="link-arrow" href={lp('/contact/')}>
          {ui.common.requestQuote} <span class="arr" aria-hidden="true">→</span>
        </a>
      </li>
    )
  }
</ul>
