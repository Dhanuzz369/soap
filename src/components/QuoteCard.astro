---
/**
 * The quote card (the site's one live thing): a Köhler lemon plate under a forest scrim and one
 * input. It is a GET form to /contact/; the contact form reads ?message= (and ?product=) and
 * prefills itself (parseEnquiryParams in src/lib/enquiry.ts).
 */
import Bubbles from './Bubbles.astro';
import { useI18n } from '../i18n/page';

interface Props {
  heading?: string;
  text?: string;
  /** Product slug to tick on the contact form. */
  product?: string;
  placeholder?: string;
  id?: string;
}
const { ui, lp } = useI18n(Astro.url);
const { heading = ui.quote.heading, text = ui.quote.text, product, placeholder = ui.quote.placeholder, id = 'quote' } = Astro.props;
---

<section class="wrap quote" aria-labelledby={`${id}-h`}>
  <div class="quote-card" data-reveal>
    <img class="quote-plate" src="/images/found/lemon-plate.webp" width="1600" height="880" alt="" loading="lazy" decoding="async" />
    <Bubbles set="quote" />
    <div class="quote-inner">
      <h2 id={`${id}-h`}>{heading}</h2>
      <p>{text}</p>
      <form class="quote-form" action={lp('/contact/')} method="get">
        {product && <input type="hidden" name="product" value={product} />}
        <label class="visually-hidden" for={`${id}-msg`}>{ui.quote.label}</label>
        <input id={`${id}-msg`} name="message" type="text" maxlength="500" autocomplete="off" placeholder={placeholder} required />
        <button class="btn btn--light" type="submit">{ui.quote.submit} <span class="arr" aria-hidden="true">→</span></button>
      </form>
    </div>
  </div>
</section>

<script>
  // Bubble parallax without scroll timelines (no-op where CSS runs it, or with reduced motion).
  import '../scripts/scroll-fallback';
</script>
