---
/**
 * Closing action band ("the action tile"): a wide forest tile flanked by two
 * flat chapter-colour tiles that run off the page edges.
 */
interface Props {
  heading?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  heading = 'Ready to quote your first container?',
  text = 'Tell us the products, pack sizes and destination port. We reply with prices, specifications and lead times.',
  primary = { label: 'Request a Quote', href: '/contact/' },
  secondary,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-h">
  <div class="cta-flank cta-flank--l" aria-hidden="true"></div>
  <div class="cta-tile">
    <h2 id="cta-h">{heading}</h2>
    <p>{text}</p>
    <div class="cta-actions">
      <a class="btn btn--inverse" href={primary.href}>{primary.label}</a>
      {secondary && <a class="link-inverse" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
  <div class="cta-flank cta-flank--r" aria-hidden="true"></div>
</section>
