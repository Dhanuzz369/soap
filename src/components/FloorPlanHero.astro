---
/**
 * FloorPlanHero: "The Floor Plan", the /horeca/ hero. A dark forest band (the .ph field and grain)
 * with the copy on the inline-start side (breadcrumbs, a two-line h1, the lead carrying the
 * approved promise, the button to the checklist and a link to the free-sample note) and, on the
 * inline-end side, a cross-section drawing of a hotel in inline SVG with six labelled spaces.
 *
 * - Each space has a hotspot: a real <button> with a visible number and name (the name is visually
 *   hidden on phones, where only the number fits). Hovering it (fine pointer) or focusing it opens
 *   a small floating card with that space's products (name and a 96px thumbnail, loaded on first
 *   open) and lights the room with a soft glow. A tap opens the card; a click, Enter or a second
 *   tap scrolls to the space's section. Escape or a click outside closes it.
 * - The card is origin-aware: it scales from the hotspot (0.96 → 1 with opacity, 180ms strong
 *   ease-out); closing is faster (120ms). Moving from one open hotspot to the next is instant.
 * - Idle life: one hotspot pulses slowly until the visitor first uses the drawing; paused when the
 *   drawing is off-screen, and absent with reduced motion.
 * - RTL: the grid mirrors (copy on the right), the drawing does not (dir="ltr" on the stage).
 * - Without JS: no hotspots; a list of links to the six sections sits under the drawing instead
 *   (html.fp-js, set before first paint, switches between the two, so there is no layout shift).
 * Styles: src/styles/horeca.css. Script: src/scripts/horeca.ts.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import { DRAWING, PULSE_SPACE, type SpaceId } from '../lib/horeca';
import { useI18n } from '../i18n/page';

interface Props {
  breadcrumbs: { name: string; url: string }[];
  spaces: {
    id: SpaceId;
    anchor: string;
    name: string;
    short: string;
    spot: { x: number; y: number };
    products: { slug: string; name: string; thumb: string }[];
  }[];
}
const { breadcrumbs, spaces } = Astro.props;
const { ui, fmt } = useI18n(Astro.url);
const H = ui.horeca;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const pad = (n: number) => String(n).padStart(2, '0');

/** The rooms of the drawing (interior rectangles), per space: the glow and the outline use them. */
const ROOMS: Record<SpaceId, [number, number, number, number][]> = {
  rooms: [
    [72, 56, 176, 116],
    [256, 56, 168, 116],
    [432, 56, 96, 116],
  ],
  kitchen: [[72, 180, 292, 102]],
  washrooms: [[372, 180, 156, 102]],
  floors: [[72, 290, 456, 102]],
  laundry: [[72, 404, 224, 92]],
  backOfHouse: [[304, 404, 224, 92]],
};
---

<script is:inline>
  // Before first paint: show the hotspots (they stay hidden without JS, where links take their place).
  document.documentElement.classList.add('fp-js');
</script>
<section class="ph ph--plan" aria-labelledby="page-h">
  <div class="wrap fp-grid">
    <div class="fp-copy">
      {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
      <h1 id="page-h" class="ph-title fp-h">
        <span class="line"><span class="line-in">{H.h1a}</span></span>
        <span class="line"><span class="line-in serif-i"> {H.h1b}</span></span>
      </h1>
      <p class="ph-lead fp-lead">{H.lead}</p>
      <div class="ph-actions fp-actions">
        <a class="btn btn--light fp-cta" href="#checklist">{H.ctaHero} <span class="arr" aria-hidden="true">↓</span></a>
        <a class="link-arrow" href="#samples">{H.sampleLink} <span class="arr" aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="fp-stage" dir="ltr" data-plan>
      <svg class="fp-svg" viewBox={`0 0 ${DRAWING.w} ${DRAWING.h}`} role="img" aria-labelledby="fp-svg-t" focusable="false">
        <title id="fp-svg-t">{H.stageTitle}</title>
        <defs>
          <radialGradient id="fp-glow">
            <stop offset="0" stop-color="#bfe3cf" stop-opacity=".5" />
            <stop offset=".7" stop-color="#bfe3cf" stop-opacity=".18" />
            <stop offset="1" stop-color="#bfe3cf" stop-opacity=".04" />
          </radialGradient>
          <linearGradient id="fp-earth" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#0d261e" />
            <stop offset="1" stop-color="#0b211a" stop-opacity="0" />
          </linearGradient>
          <pattern id="fp-soil" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="4" r=".9" fill="#a9c2b5" opacity=".18" />
            <circle cx="10" cy="11" r=".7" fill="#a9c2b5" opacity=".12" />
          </pattern>
        </defs>

        <!-- ground: the basement sits in the earth -->
        <rect x="0" y="398" width="600" height="122" fill="url(#fp-earth)" />
        <rect x="0" y="398" width="600" height="122" fill="url(#fp-soil)" />
        <path class="fp-ground" d="M0 398h600" />

        <!-- outside: a tree, the entrance canopy, the roof -->
        <g class="fp-line">
          <path d="M34 398v-30" />
          <path d="M582 398v-74M536 318h50" />
          <path d="M420 48V24h52v24M428 24l-4-10h44l-4 10" />
          <path d="M112 48V10" />
        </g>
        <circle class="fp-leafy" cx="34" cy="352" r="18" />
        <circle class="fp-leafy" cx="22" cy="366" r="11" />
        <path class="fp-acc" d="M112 10h26l-6 7 6 7h-26Z" />
        <rect class="fp-sign" x="206" y="20" width="148" height="24" rx="5" />
        <path class="fp-acc" d="M226 25c6 3.5 7 10 0 14-7-4-6-10.5 0-14Z" />
        <rect class="fp-acc-soft" x="244" y="29" width="92" height="3" rx="1.5" />
        <rect class="fp-acc-soft" x="244" y="35" width="60" height="3" rx="1.5" />

        <!-- the building: walls and floor slabs, then the rooms -->
        <rect class="fp-shell" x="64" y="48" width="472" height="456" rx="5" />
        {
          Object.values(ROOMS)
            .flat()
            .map(([x, y, w, h]) => <rect class="fp-room" x={x} y={y} width={w} height={h} rx="2" />)
        }

        <!-- 1. guest rooms & bathrooms -->
        <g class="fp-line">
          <rect x="188" y="74" width="44" height="40" rx="2" />
          <path d="M210 74v40M188 94h44" />
          <rect x="268" y="74" width="44" height="40" rx="2" />
          <path d="M290 74v40M268 94h44" />
          <path d="M84 126v46M92 140h96v20H92M188 140v32M96 160v12" />
          <path d="M412 126v46M404 140h-96v20h96M308 140v32M400 160v12" />
          <path d="M196 172v-22h24v22M326 172v-22h-24v22" />
          <path d="M204 150l-4-14h16l-4 14M316 150l4-14h-16l-4 14" />
          <rect x="452" y="74" width="30" height="36" rx="15" />
          <path d="M444 128h52M450 128c2 10 10 14 20 14s18-4 20-14M470 120v-6h8" />
          <path d="M516 64v12M508 80h16M510 88l-2 8M516 88v10M522 88l2 8" />
        </g>
        <rect class="fp-soft" x="98" y="133" width="22" height="8" rx="3" />
        <rect class="fp-soft" x="382" y="133" width="22" height="8" rx="3" />
        <path class="fp-acc-soft" d="M120 146h68v14h-68Z" />
        <path class="fp-acc-soft" d="M308 146h68v14h-68Z" />
        <circle class="fp-lamp" cx="208" cy="132" r="4" />
        <circle class="fp-lamp" cx="314" cy="132" r="4" />
        <rect class="fp-acc" x="462" y="122" width="12" height="6" rx="2" />

        <!-- 2. kitchen -->
        <g class="fp-line">
          <path d="M150 214l12-18h56l12 18ZM190 180v16" />
          <path d="M136 244h220v38M136 244v38M136 256h220" />
          <path d="M170 244v-14h26v14M206 244v-10h30" />
          <path d="M290 244c2 9 8 12 18 12s16-3 18-12M318 236v-10h10" />
          <path d="M250 212h96" />
        </g>
        <rect class="fp-acc" x="258" y="198" width="9" height="14" rx="2" />
        <rect class="fp-acc" x="272" y="200" width="9" height="12" rx="2" />
        <rect class="fp-soft" x="288" y="196" width="12" height="16" rx="2" />
        <rect class="fp-soft" x="306" y="200" width="16" height="12" rx="2" />
        <path class="fp-steam" d="M178 224c-3-4 3-6 0-10M188 224c-3-4 3-6 0-10" />

        <!-- 3. washrooms & public areas -->
        <g class="fp-line">
          <rect x="400" y="212" width="22" height="26" rx="3" />
          <rect x="440" y="212" width="22" height="26" rx="3" />
          <path d="M392 248h80M396 248c2 8 6 10 15 10s13-2 15-10M436 248c2 8 6 10 15 10s13-2 15-10" />
          <path d="M484 196v86M484 196h40M498 236h4" />
        </g>
        <rect class="fp-acc" x="426" y="216" width="8" height="14" rx="2" />

        <!-- 4. lobby, floors & housekeeping -->
        <g class="fp-line">
          <path d="M200 290v14M300 290v14M400 290v8" />
          <path d="M190 314h20l-4-10h-12ZM290 314h20l-4-10h-12Z" />
          <rect x="226" y="350" width="128" height="42" rx="4" />
          <path d="M226 360h128M290 344v6" />
          <path d="M150 372h20l-2 20h-16Z" />
          <path d="M160 372c-8-10-10-22-4-30M160 372c8-8 12-18 8-28M160 372c0-12 2-20 6-26" />
          <path d="M470 392v-72h52v72M496 320v72" />
          <path d="M420 392l20-62M406 376h26l-4 16h-18Z" />
          <path d="M120 389l10-6M250 389l10-6M380 389l10-6" />
        </g>
        <circle class="fp-lamp" cx="200" cy="316" r="3" />
        <circle class="fp-lamp" cx="300" cy="316" r="3" />

        <!-- 5. laundry -->
        <g class="fp-line">
          <rect x="110" y="438" width="46" height="56" rx="5" />
          <rect x="166" y="438" width="46" height="56" rx="5" />
          <circle cx="133" cy="470" r="13" />
          <circle cx="189" cy="470" r="13" />
          <path d="M110 448h46M166 448h46" />
        </g>
        <rect class="fp-soft" x="236" y="478" width="44" height="12" rx="4" />
        <rect class="fp-acc-soft" x="240" y="466" width="36" height="12" rx="4" />
        <rect class="fp-soft" x="238" y="454" width="40" height="12" rx="4" />

        <!-- 6. bulk & back-of-house -->
        <g class="fp-line">
          <path d="M350 430v66M420 430v66M350 436h70M350 460h70M350 484h70" />
          <path d="M440 456v38M470 456v38M478 456v38M508 456v38M440 468h30M478 468h30M436 494h76" />
        </g>
        <ellipse class="fp-acc-soft" cx="455" cy="456" rx="15" ry="4" />
        <ellipse class="fp-acc-soft" cx="493" cy="456" rx="15" ry="4" />
        <rect class="fp-acc" x="358" y="444" width="12" height="16" rx="2" />
        <rect class="fp-acc" x="374" y="444" width="12" height="16" rx="2" />
        <rect class="fp-soft" x="392" y="446" width="12" height="14" rx="2" />
        <rect class="fp-soft" x="358" y="470" width="16" height="14" rx="2" />
        <rect class="fp-acc" x="378" y="468" width="16" height="16" rx="2" />

        <!-- the glow and outline of each space (lit by the hotspots) -->
        {
          spaces.map((s) => (
            <g class="fp-hl" data-space-g={s.id}>
              {ROOMS[s.id].map(([x, y, w, h]) => (
                <>
                  <rect class="fp-hl-glow" x={x} y={y} width={w} height={h} rx="2" />
                  <rect class="fp-hl-edge" x={x + 1} y={y + 1} width={w - 2} height={h - 2} rx="2" />
                </>
              ))}
            </g>
          ))
        }
      </svg>

      <div class="fp-spots" role="group" aria-label={H.spacesNav}>
        {
          spaces.map((s, i) => (
            <>
              <button
                type="button"
                class="fp-spot"
                style={`left: ${pct(s.spot.x, DRAWING.w)}; top: ${pct(s.spot.y, DRAWING.h)}; --n: ${i}`}
                data-spot={s.id}
                data-target={`#${s.anchor}`}
                data-pulse={s.id === PULSE_SPACE ? '' : undefined}
                aria-expanded="false"
                aria-controls={`fp-card-${s.id}`}
              >
                <span class="fp-pin" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="fp-name">{s.short}</span>
              </button>
              <div class="fp-card" id={`fp-card-${s.id}`} data-card={s.id} role="region" aria-label={s.name}>
                <p class="fp-card-h">{s.name}</p>
                <ul class="fp-card-list">
                  {s.products.map((p) => (
                    <li>
                      <img data-src={p.thumb} alt="" width="40" height="40" decoding="async" />
                      <span>{p.name}</span>
                    </li>
                  ))}
                </ul>
                <a class="fp-card-link" href={`#${s.anchor}`}>
                  {fmt(H.cardLink, { n: s.products.length })} <span aria-hidden="true">↓</span>
                </a>
              </div>
            </>
          ))
        }
      </div>
      <p class="fp-hint">{H.stageHint}</p>
      <nav class="fp-legend" aria-label={H.spacesNav}>
        <ol>
          {
            spaces.map((s, i) => (
              <li>
                <a href={`#${s.anchor}`}>
                  <span class="fp-pin" aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
</section>
