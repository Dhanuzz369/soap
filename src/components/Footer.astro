---
import site from '../config/site';
import { buildWhatsAppUrl } from '../lib/enquiry';
import { getProductsByCategory } from '../lib/products';
import Registrations from './Registrations.astro';
import { useI18n } from '../i18n/page';

const { lang, ui, lp, fmt } = useI18n(Astro.url);
const categories = (await getProductsByCategory(lang)).map((g) => g.category);
const n = ui.header.nav;
const company = [
  { label: n.horeca, href: '/horeca/' },
  { label: n.privateLabel, href: '/private-label/' },
  { label: n.exportProcess, href: '/export-process/' },
  { label: n.about, href: '/about/' },
  { label: ui.footer.vetting, href: '/about/#how-we-vet' },
  { label: n.guides, href: '/blog/' },
  { label: n.faq, href: '/faq/' },
  { label: ui.common.requestQuote, href: '/contact/' },
];
const year = new Date().getFullYear();
const tel = site.contact.phone.replace(/[^+\d]/g, '');
const t = ui.terms;
// "{name} is a unit of {parent}, {place}.": {parent} is a link to the GoodBiz Global website.
const [legalBefore, legalAfter = ''] = ui.footer.legal.split('{parent}');
const legalVars = { name: site.name, place: site.contact.address };
const parentUrl = site.facts.parentUrl;
---

<footer class="site-footer">
  <svg class="footer-ghost" viewBox="0 0 1000 190" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <text x="500" y="168" text-anchor="middle">GOODBIZ</text>
  </svg>

  <div class="wrap footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">GoodBiz Hygiene.</p>
        <p class="footer-tag">{ui.footer.tag}</p>
        <p class="footer-lede">{fmt(ui.footer.lede, { parent: site.parentName })}</p>
        <p class="footer-terms">{t.incoterms}. {t.port}. {t.leadTime}.</p>
      </div>

      <nav class="footer-links" aria-label={ui.footer.nav}>
        <div>
          <h2>{ui.footer.products}</h2>
          <ul>
            <li><a href={lp('/products/')}>{ui.common.allProducts}</a></li>
            {categories.map((c) => <li><a href={lp(`/categories/${c.data.slug}/`)}>{c.data.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>{ui.footer.company}</h2>
          <ul>
            {company.map((l) => <li><a href={lp(l.href)}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>{ui.footer.contact}</h2>
          <ul>
            <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
            <li><a href={buildWhatsAppUrl(site.contact.whatsapp, {})} rel="noopener" target="_blank">{ui.footer.whatsapp}</a></li>
            <li><a href={`tel:${tel}`} dir="ltr">{site.contact.phone}</a></li>
            <li>{site.contact.address}</li>
          </ul>
        </div>
      </nav>
    </div>

    <Registrations variant="compact" />

    <div class="footer-legal">
      <p class="footer-unit">
        <span>© {year} {site.name}.</span>{' '}
        <span>
          {fmt(legalBefore, legalVars)}{parentUrl ? <a href={parentUrl} rel="noopener">{site.parentName}</a> : site.parentName}{fmt(legalAfter, legalVars)}
        </span>{' '}
        <span class="footer-unit-contact">
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <span aria-hidden="true">·</span>
          <a href={`tel:${tel}`} dir="ltr">{site.contact.phone}</a>
        </span>
      </p>
      <a href="#top">{ui.footer.backToTop}</a>
    </div>
  </div>
</footer>
