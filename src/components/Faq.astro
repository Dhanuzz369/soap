---
/** FAQ list as <details>/<summary> bands. The page passes the FAQPage JSON-LD itself. */
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  id?: string;
}
const { faqs, heading = 'Questions buyers ask', id = 'faq' } = Astro.props;
---

<section class="faq" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`} class="faq-h">{heading}</h2>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <details class="faq-item">
          <summary>
            <span class="faq-q">{f.q}</span>
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <div class="faq-a">
            <p>{f.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
