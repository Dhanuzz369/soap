---
/**
 * FAQ as Floria accordion rows (<details>/<summary>, works without JS). With `split`, the heading
 * sits on the left and the questions on the right. The page passes the FAQPage JSON-LD itself.
 */
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  id?: string;
  split?: boolean;
  intro?: string;
}
const { faqs, heading = 'Questions buyers ask', id = 'faq', split = false, intro } = Astro.props;
---

<section class:list={['faq', 'wrap', 'sec', split && 'split']} id={id} aria-labelledby={`${id}-h`}>
  <div class:list={[split && 'split-head']} data-reveal>
    <h2 id={`${id}-h`} class="faq-h">{heading}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <div class="faq-list" data-reveal style="--i: 1">
    {
      faqs.map((f) => (
        <details class="faq-item">
          <summary>
            <span class="faq-q">{f.q}</span>
            <span class="faq-sign" aria-hidden="true" />
          </summary>
          <div class="faq-a">
            <p>{f.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
