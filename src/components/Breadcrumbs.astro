---
/** Visible breadcrumb trail. The BreadcrumbList JSON-LD is emitted by BaseLayout. */
interface Props {
  items: { name: string; url: string }[];
}
import { useI18n } from '../i18n/page';
const { items } = Astro.props;
const { ui } = useI18n(Astro.url);
---

{
  items.length > 1 && (
    <nav class="crumbs" aria-label={ui.common.breadcrumb}>
      <ol>
        {items.map((it, i) => (
          <li>
            {i < items.length - 1 ? (
              <a href={it.url}>{it.name}</a>
            ) : (
              <span aria-current="page">{it.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
