---
/**
 * EnquiryForm (spec §10).
 * Without JS it is a plain mailto: form (enctype text/plain), so a buyer can always reach us,
 * and the WhatsApp link below it is a real href. With JS, enquiry-form.ts pre-selects products
 * from ?product=<slug> and, on submit, offers "Send via WhatsApp" and "Send via Email" links
 * built from the same answers.
 */
import site from '../config/site';
import { getProductsByCategory } from '../lib/products';
import { FORM_FIELDS as F, buildWhatsAppUrl } from '../lib/enquiry';

const groups = await getProductsByCategory();
const quantities = [
  'Samples or a trial quantity',
  'Part of a mixed container',
  '1 x 20ft container',
  '1 x 40ft container',
  'Several containers or regular supply',
  'Not sure yet',
];
const waPlain = buildWhatsAppUrl(site.contact.whatsapp, {});
---

<form
  class="enq"
  method="post"
  action={`mailto:${site.contact.email}`}
  enctype="text/plain"
  data-enquiry
  data-email={site.contact.email}
  data-whatsapp={site.contact.whatsapp}
>
  <div class="enq-grid">
    <div class="enq-field">
      <label for="enq-name">Your name</label>
      <input id="enq-name" name={F.name} type="text" autocomplete="name" required />
    </div>
    <div class="enq-field">
      <label for="enq-company">Company</label>
      <input id="enq-company" name={F.company} type="text" autocomplete="organization" />
    </div>
    <div class="enq-field">
      <label for="enq-country">Country</label>
      <input id="enq-country" name={F.country} type="text" autocomplete="country-name" required />
    </div>
    <div class="enq-field">
      <label for="enq-email">Email</label>
      <input id="enq-email" name={F.email} type="email" autocomplete="email" required />
    </div>
    <div class="enq-field">
      <label for="enq-phone">WhatsApp or phone <span class="enq-opt">(with country code)</span></label>
      <input id="enq-phone" name={F.phone} type="tel" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="enq-field">
      <label for="enq-qty">Quantity</label>
      <select id="enq-qty" name={F.quantity}>
        <option value="">Choose one</option>
        {quantities.map((q) => <option value={q}>{q}</option>)}
      </select>
    </div>
  </div>

  <fieldset class="enq-products">
    <legend>Products of interest <span class="enq-opt">(choose any)</span></legend>
    {
      groups.map((g) => (
        <div class="enq-range" data-cat={g.category.data.slug}>
          <p class="enq-range-name">{g.category.data.title}</p>
          <ul class="enq-checks">
            {g.products.map((p) => (
              <li>
                <input
                  type="checkbox"
                  id={`enq-p-${p.data.slug}`}
                  name={F.products}
                  value={p.data.title}
                  data-slug={p.data.slug}
                />
                <label for={`enq-p-${p.data.slug}`}>{p.data.title}</label>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </fieldset>

  <fieldset class="enq-pl">
    <legend>Do you need private label?</legend>
    <div class="enq-radios">
      <input type="radio" id="enq-pl-yes" name={F.privateLabel} value="Yes" />
      <label for="enq-pl-yes">Yes, under my brand</label>
      <input type="radio" id="enq-pl-no" name={F.privateLabel} value="No" />
      <label for="enq-pl-no">No</label>
    </div>
  </fieldset>

  <div class="enq-field enq-field--wide">
    <label for="enq-msg">Message <span class="enq-opt">(pack sizes, fragrances, destination port)</span></label>
    <textarea id="enq-msg" name={F.message} rows="5"></textarea>
  </div>

  <div class="enq-actions">
    <button class="btn" type="submit">Send enquiry</button>
    <p class="note enq-hint" data-enquiry-hint>
      This opens your email app with the enquiry filled in. Prefer WhatsApp?
      <a href={waPlain} rel="noopener" target="_blank">Message us on WhatsApp</a>.
    </p>
  </div>

  <div class="enq-send" data-enquiry-send hidden tabindex="-1" aria-labelledby="enq-send-h">
    <p id="enq-send-h" class="enq-send-h">Your enquiry is ready. How would you like to send it?</p>
    <div class="enq-send-actions">
      <a class="btn" data-send-whatsapp href={waPlain} target="_blank" rel="noopener">Send via WhatsApp</a>
      <a class="btn btn--soft" data-send-email href={`mailto:${site.contact.email}`}>Send via Email</a>
    </div>
    <p class="note">Each opens your own app with the message written out, so you can check it before sending.</p>
  </div>
</form>

<script>
  import { initEnquiryForms } from '../scripts/enquiry-form';
  initEnquiryForms();
</script>
