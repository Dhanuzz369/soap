---
/**
 * Tall rounded product card (the reference's "assemblage" card): the picture, then the name on
 * the left and the HSN code on the right. "Add to enquiry" opens the contact form with this
 * product ticked; it slides in on hover (fine pointers) and is always shown on touch screens.
 */
import type { ProductEntry } from '../lib/products';
import ProductVisual from './ProductVisual.astro';
import { useI18n } from '../i18n/page';

interface Props {
  product: ProductEntry;
  /** Show the varieties line under the name (inner pages). */
  details?: boolean;
  eager?: boolean;
}
const { product, details = true, eager = false } = Astro.props;
const d = product.data;
const { ui, lp, fmt } = useI18n(Astro.url);
const href = lp(`/products/${d.slug}/`);
const varieties = d.variants.slice(0, 3);
---

<article class="pcard" data-cat={d.category.id}>
  <div class="pcard-media">
    <ProductVisual slug={d.slug} title={d.title} category={d.category.id} size="card" eager={eager} />
    <a class="pcard-chip" href={lp(`/contact/?product=${d.slug}`)} aria-label={fmt(ui.cards.addAria, { name: d.title })}>{ui.cards.addToEnquiry}</a>
  </div>
  <div class="pcard-row">
    <h3 class="pcard-title"><a href={href}>{d.title}</a></h3>
    <span class="pcard-hsn"><abbr title={ui.common.hsnTitle}>{ui.common.hsn}</abbr>&nbsp;{d.hsn}</span>
  </div>
  {details && varieties.length > 0 && <p class="pcard-vars">{varieties.join(' · ')}</p>}
</article>
