---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Faq from '../components/Faq.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { faqJsonLd } from '../lib/seo';
import site from '../config/site';

const t = site.exportTerms;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Export Process', url: '/export-process/' },
];

const steps = [
  { title: 'Enquiry', text: 'Send the products, pack sizes, quantity, destination port and any private-label needs, using the enquiry form, email or WhatsApp.' },
  { title: 'Quotation', text: `We quote prices per pack with typical specifications, the incoterm you need and the lead time. ${t.incoterms}.` },
  { title: 'Samples and approvals', text: 'Product samples and, for private label, artwork proofs are approved before the order is confirmed.' },
  { title: 'Proforma invoice and payment', text: 'A proforma invoice confirms products, quantities, packing, incoterm and payment terms (T/T or LC).' },
  { title: 'Production and packing', text: 'The manufacturer produces and packs the order, marked for export and for your market.' },
  { title: 'Documents and shipping', text: `We prepare the export documents and book the shipment. ${t.port}.` },
].map((s) => ({ name: s.title, text: s.text }));

const documents = [
  'Commercial invoice',
  'Packing list',
  'Certificate of origin',
  'Bill of lading (sea freight)',
  'Certificate of analysis (COA)',
  'Material safety data sheet (MSDS)',
];

const faqs = [
  { q: 'Which incoterms do you offer?', a: `${t.incoterms}.` },
  { q: 'Which port do shipments leave from?', a: `${t.port}. The port is chosen by product, manufacturer location and your destination, and stated on the quotation.` },
  { q: 'What is the lead time?', a: `${t.leadTime}.` },
  {
    q: 'Which documents are included?',
    a: `Shipments normally travel with ${documents.slice(0, 4).join(', ').toLowerCase()}, plus a COA and MSDS where the product needs them. Your country may need more, such as a health certificate or legalised invoice; this is agreed per order.`,
  },
  {
    q: 'Which HSN code goes on the invoice?',
    a: 'The site shows HSN codes at 6 digits, for example 3402 50. The 8-digit ITC-HS code is confirmed per order. Fabric softener and herbal phenol can fall under alternative classifications (3809 91 and 3808 94).',
  },
];
---

<BaseLayout
  title="Export Process: Soap & Home-Care Exporter & Supplier from India"
  description="How GoodBiz Hygiene exports soaps, detergents and cleaners from India: quotation, samples, incoterms, payment terms, documents, ports and typical lead times."
  path="/export-process/"
  breadcrumbs={breadcrumbs}
  jsonLd={[faqJsonLd(faqs)]}
  dark
>
  <PageHero
    breadcrumbs={breadcrumbs}
    l1="The export process."
    l2="From enquiry to bill of lading."
    lead="The steps, terms and documents for buying soaps and home-care products from India through GoodBiz Hygiene."
    size="product"
    media={{
      src: '/images/renders/range-hero.webp',
      width: 1600,
      height: 1000,
      alt: 'Illustration of the GoodBiz Hygiene range in typical export packs',
      mode: 'bleed',
      position: '96% 60%',
    }}
  >
    <div class="ph-actions">
      <a class="btn btn--light" href="/contact/">Request a Quote</a>
      <a class="link-arrow" href="#steps">The six steps <span class="arr" aria-hidden="true">↓</span></a>
    </div>
  </PageHero>

  <section class="wrap sec" aria-labelledby="terms-h">
    <div class="sec-head" data-reveal>
      <h2 id="terms-h">What are the export terms?</h2>
    </div>
    <dl class="facts" data-reveal style="--i: 1">
      <div><dt>Incoterms and payment</dt><dd>{t.incoterms}</dd></div>
      <div><dt>Port</dt><dd>{t.port}</dd></div>
      <div><dt>Lead time</dt><dd>{t.leadTime}</dd></div>
    </dl>
  </section>

  <div id="steps">
    <ProcessSteps
      id="steps-p"
      l1="What are the steps"
      l2="from enquiry to shipment?"
      intro="Six steps, with your approval on the quotation, samples and proforma invoice before anything is produced."
      steps={steps}
      photo
    />
  </div>

  <section class="wrap sec split" aria-labelledby="docs-h">
    <div class="split-head" data-reveal>
      <h2 id="docs-h">Which documents come with a shipment?</h2>
      <p>The exact set depends on your country and is confirmed per order.</p>
    </div>
    <ul class="chips chips--lg" data-reveal style="--i: 1">
      {documents.map((d) => <li class="chip">{d}</li>)}
    </ul>
  </section>

  <Faq faqs={faqs} heading="Export process: questions buyers ask" split />

  <QuoteCard />
</BaseLayout>
