---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../config/site';
import { getProductsByCategory } from '../lib/products';
import { faqJsonLd } from '../lib/seo';
import { homeFaqs } from '../lib/faqs';
import { shapes, byCategory } from '../lib/pack-shapes';

const groups = await getProductsByCategory();
const allProducts = groups.flatMap((g) => g.products);
const total = allProducts.length;

const featuredSlugs = ['dish-wash-liquid', 'fabric-softener', 'toilet-bath-soap', 'floor-cleaner', 'detergent-powder', 'soap-noodles'];
const featured = featuredSlugs
  .map((s) => allProducts.find((p) => p.data.slug === s))
  .filter((p): p is NonNullable<typeof p> => !!p);

const tile = (shape: keyof typeof shapes) => `<svg viewBox="0 0 240 240" aria-hidden="true" focusable="false">${shapes[shape]}</svg>`;

const reasons = [
  {
    title: 'Private label, arranged for you',
    text: 'Your artwork on the label, carton or wrapper, with fragrance, colour and pack choices agreed with the manufacturer. Artwork and a sample are approved before bulk production.',
    shape: 'bar' as const,
    cat: 'bath-personal-soaps',
    link: { href: '/private-label/', label: 'How private label works' },
  },
  {
    title: 'Pack sizes that suit your shelf',
    text: 'Retail bottles, pouches and bars for supermarkets, refill cans for distributors, and bulk drums and bags for institutions and manufacturers. Each product page lists its typical packs.',
    shape: 'pouch' as const,
    cat: 'laundry-care',
  },
  {
    title: 'Export documents prepared',
    text: 'Commercial invoice, packing list, certificate of origin and product documents such as COA and MSDS, prepared for each shipment and checked against your country’s requirements.',
    shape: 'carboy' as const,
    cat: 'surface-home-cleaners',
    link: { href: '/export-process/', label: 'See the export process' },
  },
  {
    title: 'Mixed containers from one supplier',
    text: 'Combine soaps, detergents and cleaners from several ranges in one 20ft or 40ft container, so you can trial a range without filling a container per product.',
    shape: 'drum' as const,
    cat: 'kitchen-care',
  },
];

const t = site.exportTerms;
const steps = [
  {
    name: 'Quote',
    text: 'Tell us the products, pack sizes, quantity and destination port. We reply with prices, typical specifications and lead times.',
    shape: 'squeeze' as const,
    cat: 'kitchen-care',
  },
  {
    name: 'Sample and confirm',
    text: `Approve samples and, for private label, your artwork. ${t.incoterms}.`,
    shape: 'carboy' as const,
    cat: 'bath-personal-soaps',
  },
  {
    name: 'Ship',
    text: `The manufacturer produces and packs your order while we prepare the documents. ${t.port}. ${t.leadTime}.`,
    shape: 'container' as const,
    cat: 'laundry-care',
  },
];
const container = `<g>
  <ellipse class="pv-g" cx="120" cy="196" rx="104" ry="6"/>
  <rect class="pv-d" x="18" y="92" width="204" height="100"/>
  <g class="pv-b">${Array.from({ length: 11 }, (_, i) => `<rect x="${26 + i * 17.6}" y="100" width="11" height="84"/>`).join('')}</g>
  <rect class="pv-l" x="150" y="112" width="56" height="34"/>
  <g transform="translate(178 126) scale(.8)"><path class="pv-d" d="M0-11C9-7 9 6 0 11C-9 6-9-7 0-11Z"/><path class="pv-l" d="M-.9-7h1.8v16h-1.8z"/></g>
</g>`;
---

<BaseLayout
  title="Soap & Home-Care Products Exporter & Supplier from India"
  description="GoodBiz Hygiene, a GoodBiz Global company, exports soaps, detergents and home-care products from vetted Indian manufacturers, with private label and mixed containers."
  path="/"
  jsonLd={[faqJsonLd(homeFaqs)]}
>
  <section class="hero" aria-labelledby="hero-h">
    <div class="mosaic">
      <div class="mosaic-stage"><HeroScene /></div>
      <div class="mosaic-tile mt-a" data-cat="kitchen-care" set:html={tile('squeeze')} />
      <div class="mosaic-tile mt-b" data-cat="bath-personal-soaps" set:html={tile('bar-clear')} />
      <div class="mosaic-tile mt-c" data-cat="industrial-raw-materials" set:html={tile('sack')} />
    </div>
    <div class="wrap hero-copy">
      <h1 id="hero-h" class="hero-h">GoodBiz Hygiene, soap &amp; <span class="nowrap">home-care</span> exporter &amp; supplier from India</h1>
      <p class="hero-stand">
        Soaps, detergents and cleaners from vetted Indian manufacturers, with private label and mixed containers for importers worldwide.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/contact/">Request a Quote</a>
        <a class="btn btn--soft" href="/products/">View Products</a>
      </div>
    </div>
  </section>

  <section class="ranges" aria-labelledby="ranges-h">
    <div class="wrap ranges-head" data-reveal>
      <h2 id="ranges-h">Five ranges to fill one container</h2>
      <p class="lead">{total} products under HSN 3401 and 3402, from bath soap to the surfactants soap makers buy.</p>
    </div>
    <ul class="range-strip">
      {
        groups.map((g, i) => (
          <li class="range-tile" data-cat={g.category.data.slug} data-reveal style={`--d:${i * 70}ms`}>
            <div class="range-art" set:html={tile(byCategory[g.category.data.slug] ?? 'squeeze')} />
            <h3 class="range-name">
              <a href={`/categories/${g.category.data.slug}/`}>{g.category.data.title}</a>
            </h3>
            <p class="range-meta">
              {g.products.length} products · HSN {g.category.data.hsnRange}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section featured" aria-labelledby="featured-h">
    <div class="featured-head" data-reveal>
      <h2 id="featured-h">From the range</h2>
      <a class="featured-all" href="/products/">All {total} products</a>
    </div>
    <div class="grid-cards featured-grid">
      {
        featured.map((p, i) => (
          <div data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <ProductCard product={p} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="why" aria-labelledby="why-h">
    <div class="wrap why-grid">
      <div class="why-head" data-reveal>
        <h2 id="why-h">Why source through GoodBiz Hygiene</h2>
        <p class="lead">
          One merchant exporter between you and India’s soap and detergent makers: we match your brief to the right manufacturer, then
          handle the quote, the paperwork and the shipment.
        </p>
      </div>
      <ul class="why-list">
        {
          reasons.map((r, i) => (
            <li class="why-item" data-reveal style={`--d:${i * 60}ms`}>
              <div class="why-art" data-cat={r.cat} set:html={tile(r.shape)} />
              <div>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
                {r.link && (
                  <p class="why-link">
                    <a href={r.link.href}>{r.link.label}</a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section steps" aria-labelledby="steps-h">
    <div class="steps-row">
      <div class="steps-intro" data-reveal>
        <h2 id="steps-h">From enquiry to port</h2>
        <p><a href="/export-process/">How export orders work, in full</a></p>
      </div>
      <ol class="steps-list">
        {
          steps.map((s, i) => (
            <li class={`step step--${i + 1}`} data-reveal style={`--d:${i * 90}ms`}>
              <div
                class="step-tile"
                data-cat={s.cat}
                set:html={`<svg viewBox="0 0 240 240" aria-hidden="true" focusable="false">${s.shape === 'container' ? container : shapes[s.shape]}</svg>`}
              />
              <h3 class="step-name">{s.name}</h3>
              <p class="step-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wrap home-faq" data-reveal>
    <Faq faqs={homeFaqs} heading="Questions importers ask first" id="home-faq" />
    <p class="home-faq-more"><a href="/faq/">More answers on the FAQ page</a></p>
  </div>

  <CtaBand
    heading="Ready to quote your first container?"
    secondary={{ label: 'See private label options', href: '/private-label/' }}
  />
</BaseLayout>
