---
/**
 * Home (Floria-style restyle; docs/superpowers/specs/2026-10-16-floria-restyle-direction.md).
 * Dark hero with the live range → The Range → how export orders work → The Categories →
 * Straight answers → statement → buyer guides → the quote card → footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import HeroScene from '../components/HeroScene.astro';
import ProductCard from '../components/ProductCard.astro';
import site from '../config/site';
import { getProductsByCategory } from '../lib/products';
import { faqJsonLd } from '../lib/seo';
import { homeFaqs } from '../lib/faqs';
import { getPosts, fmtDate } from '../lib/blog';
import { foundPictures } from '../data/found-pictures';

const groups = await getProductsByCategory();
const latestPosts = (await getPosts()).slice(0, 3);
const allProducts = groups.flatMap((g) => g.products);
const total = allProducts.length;

const rangeSlugs = ['dish-wash-liquid', 'fabric-softener', 'floor-cleaner'];
const range = rangeSlugs
  .map((s) => allProducts.find((p) => p.data.slug === s))
  .filter((p): p is NonNullable<typeof p> => !!p);

const t = site.exportTerms;
const steps = [
  {
    name: 'Specification and samples',
    text: 'Send the products, pack sizes, quantity and destination port. We quote prices per pack with typical specifications and lead times, and arrange samples for your approval.',
  },
  {
    name: 'Sourcing and private label',
    text: 'We match your brief to a vetted Indian manufacturer. For private label, your artwork, fragrance and pack choices are approved before bulk production.',
  },
  {
    name: 'Documents and shipping',
    text: `The manufacturer produces and packs the order while we prepare the invoice, packing list, certificate of origin, COA and MSDS. ${t.port}. ${t.leadTime}.`,
  },
];

/* The bento: bath soaps large, raw materials tall, the other three small. */
const tileOrder = ['bath-personal-soaps', 'industrial-raw-materials', 'laundry-care', 'kitchen-care', 'surface-home-cleaners'];
const tiles = tileOrder
  .map((slug) => groups.find((g) => g.category.data.slug === slug))
  .filter((g): g is NonNullable<typeof g> => !!g)
  .map((g) => {
    const slug = g.category.data.slug;
    const size = slug === 'bath-personal-soaps' ? 'large' : slug === 'industrial-raw-materials' ? 'tall' : 'small';
    const dims = size === 'large' ? [1440, 1200] : size === 'tall' ? [760, 1200] : [1000, 800];
    return { g, slug, size, w: dims[0], h: dims[1] };
  });

const port = foundPictures.find((p) => p.file.includes('kochi'))!;
---

<BaseLayout
  title="Soap & Home-Care Products Exporter & Supplier from India"
  description="GoodBiz Hygiene, a GoodBiz Global company, exports soaps, detergents and home-care products from vetted Indian manufacturers, with private label and mixed containers."
  path="/"
  jsonLd={[faqJsonLd(homeFaqs)]}
  dark
  preloadImage={{ href: '/images/renders/range-hero.webp' }}
>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <HeroScene />
    <div class="wrap hero-copy">
      <p class="hero-eyebrow"><!-- taste-skill-ignore: pill eyebrow allowed by the direction -->Soaps · Detergents · Home care</p>
      <h1 id="hero-h" class="hero-h">
        <span class="line"><span class="line-in">Soap &amp; Home Care</span></span>
        <span class="line"><span class="line-in serif-i">Exported from India.</span></span>
      </h1>
      <p class="hero-text">
        GoodBiz Hygiene is a merchant exporter: we source soaps, detergents and cleaners from vetted Indian manufacturers, with
        private label and mixed containers.
      </p>
      <div class="hero-actions">
        <a class="btn btn--light" href="/products/">View Products</a>
        <a class="link-arrow hero-link" href="/contact/">Request a Quote <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 2. The Range -->
  <section class="wrap range" aria-labelledby="range-h">
    <div class="range-head">
      <div data-reveal>
        <h2 id="range-h">The Range.</h2>
        <p class="range-intro">
          Three of {total} products. Each has its own page with typical specifications, pack sizes and private-label options.
        </p>
      </div>
      <a class="range-all link-arrow" href="/products/" data-reveal style="--i: 1">
        View all {total} products <span class="arr" aria-hidden="true">↗</span>
      </a>
    </div>
    <ul class="range-cards">
      {
        range.map((p, i) => (
          <li class={`range-card range-card--${i + 1}`} data-reveal style={`--i: ${i + 1}`}>
            <ProductCard product={p} details={false} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. How export orders work -->
  <section class="process" aria-labelledby="process-h">
    <div class="wrap process-grid">
      <div class="process-head">
        <div class="process-sticky">
          <h2 id="process-h" data-reveal>
            How export <span class="serif-i">orders work.</span>
          </h2>
          <p class="process-intro" data-reveal style="--i: 1">
            One merchant exporter between you and the manufacturer: the quote, the samples, the paperwork and the shipment, from the first
            message to the bill of lading.
          </p>
          <figure class="process-photo" data-reveal style="--i: 2">
            <div class="process-photo-frame">
            <img
              src="/images/found/kochi-port-night-600.webp"
              srcset="/images/found/kochi-port-night-600.webp 600w, /images/found/kochi-port-night.webp 1200w"
              sizes="(max-width: 900px) 92vw, 480px"
              width="1200"
              height="900"
              alt="Gantry cranes loading a container ship at night at the International Container Transshipment Terminal in Kochi, India"
              loading="lazy"
              decoding="async"
            />
            </div>
            <figcaption>Container terminal, Kochi. Photo: {port.creator}, {port.license}.</figcaption>
          </figure>
          <p data-reveal style="--i: 3">
            <a class="link-arrow process-link" href="/export-process/">The export process in full <span class="arr" aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class={`step step--${i + 1}`} data-step>
              <span class="step-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0') /* taste-skill-ignore: 01/02/03 circles, allowed by the direction */}
              </span>
              <div class="step-body">
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. The Categories -->
  <section class="wrap cats" aria-labelledby="cats-h">
    <div class="cats-head" data-reveal>
      <h2 id="cats-h">The Categories.</h2>
      <p>Five ranges under HSN 3401 and 3402. Mix them in one 20ft or 40ft container.</p>
    </div>
    <ul class="bento">
      {
        tiles.map(({ g, slug, size, w, h }, i) => (
          <li class={`tile tile--${size}`} data-reveal style={`--i: ${i % 3}`}>
            <a class="tile-link" href={`/categories/${slug}/`}>
              <img
                src={`/images/renders/category-${slug}.webp`}
                width={w}
                height={h}
                alt={`Illustration of typical ${g.category.data.title.toLowerCase()} packs`}
                loading="lazy"
                decoding="async"
              />
              <div class="tile-label">
                <h3 class="tile-title">{g.category.data.title}</h3>
                <span class="tile-meta">
                  {g.products.length} products · HSN {g.category.data.hsnRange}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Straight answers -->
  <section class="answers" aria-labelledby="answers-h">
    <div class="wrap">
      <h2 id="answers-h" class="answers-h serif-i" data-reveal>Straight answers.</h2>
      <ul class="answer-wall">
        {
          homeFaqs.map((f, i) => (
            <li class="answer" data-reveal style={`--i: ${i % 3}`}>
              <h3 class="answer-q">{f.q}</h3>
              <p class="answer-a">{f.a}</p>
              <p class="answer-sign">Buyer FAQ</p>
            </li>
          ))
        }
      </ul>
      <p class="answers-more" data-reveal>
        <a class="link-arrow" href="/faq/">More answers on the FAQ page <span class="arr" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 6. Statement -->
  <section class="statement" aria-labelledby="statement-h">
    <img class="statement-plate" src="/images/found/neem-plate.webp" width="1100" height="682" alt="" loading="lazy" decoding="async" />
    <div class="wrap statement-inner">
      <svg class="statement-leaf" viewBox="0 0 48 48" aria-hidden="true" focusable="false" data-reveal>
        <path d="M40 8C22 8 10 18 10 31c0 3 .7 5.6 2 8M40 8c0 17-9.5 29-24 29-1.5 0-2.8-.2-4-.5M40 8 15 34" />
      </svg>
      <h2 id="statement-h" data-reveal style="--i: 1">Never a generic supplier.</h2>
      <p data-reveal style="--i: 2">
        GoodBiz Hygiene does not manufacture. We match each brief to a vetted Indian maker, publish typical specifications, and confirm
        every grade, pack and port in writing on the quote.
      </p>
    </div>
  </section>

  <!-- 7. Buyer guides -->
  {
    latestPosts.length > 0 && (
      <section class="wrap guides" aria-labelledby="guides-h">
        <div class="guides-head" data-reveal>
          <h2 id="guides-h">Buyer guides</h2>
          <a class="link-arrow" href="/blog/">
            All guides <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="guide-rows">
          {latestPosts.map((p, i) => (
            <li class="guide" data-reveal style={`--i: ${i}`}>
              <time class="guide-date" datetime={p.data.date.toISOString().slice(0, 10)}>
                {fmtDate(p.data.date)}
              </time>
              <h3 class="guide-title">
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </h3>
              <p class="guide-desc">{p.data.description}</p>
              <span class="guide-arrow" aria-hidden="true">
                ↗
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 8. The quote card: the one live thing -->
  <section class="wrap quote" aria-labelledby="quote-h">
    <div class="quote-card" data-reveal>
      <img class="quote-plate" src="/images/found/lemon-plate.webp" width="1600" height="880" alt="" loading="lazy" decoding="async" />
      <div class="quote-inner">
        <h2 id="quote-h">Request a quote.</h2>
        <p>Tell us what you need in one line. The enquiry form opens with it written in, ready for your products, quantity and port.</p>
        <form class="quote-form" action="/contact/" method="get">
          <label class="visually-hidden" for="quote-msg">What do you need?</label>
          <input
            id="quote-msg"
            name="message"
            type="text"
            maxlength="500"
            autocomplete="off"
            placeholder="e.g. 1×20ft dish wash, lemon, 500 ml"
            required
          />
          <button class="btn btn--light" type="submit">Start enquiry <span aria-hidden="true">→</span></button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
