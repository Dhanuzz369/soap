---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Page not found"
  description="This page could not be found. Browse GoodBiz Hygiene's soaps and home-care products or request a quote."
  path="/404/"
  noindex
  dark
>
  <PageHero
    l1="This page is not"
    l2="on the shelf."
    lead="The link may be old or mistyped. The full range is one click away."
    size="product"
    id="nf-h"
    media={{
      src: '/images/renders/spray.webp',
      srcset: '/images/renders/spray-600.webp 600w, /images/renders/spray.webp 1200w',
      sizes: '(max-width: 759px) 100vw, 54vw',
      width: 1200,
      height: 1500,
      alt: 'Illustration of a spray cleaner bottle',
      mode: 'bleed',
      cutout: true,
    }}
  >
    <div class="nf-links">
      <a class="btn btn--light" href="/products/">View Products</a>
      <a class="link-arrow" href="/contact/">Request a Quote <span class="arr" aria-hidden="true">→</span></a>
      <a class="link-arrow" href="/">Home <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </PageHero>
</BaseLayout>
