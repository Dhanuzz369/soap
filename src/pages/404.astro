---
import BaseLayout from '../layouts/BaseLayout.astro';
import { shapes } from '../lib/pack-shapes';
---

<BaseLayout
  title="Page not found"
  description="This page could not be found. Browse GoodBiz Hygiene's soaps and home-care products or request a quote."
  path="/404/"
>
  <section class="wrap nf" aria-labelledby="nf-h">
    <div>
      <h1 id="nf-h" class="page-title">This page is not on the shelf</h1>
      <p class="lead" style="margin-top:24px">The link may be old or mistyped. The full range is one click away.</p>
      <div class="nf-links">
        <a class="btn" href="/products/">View Products</a>
        <a class="btn btn--soft" href="/contact/">Request a Quote</a>
        <a class="btn btn--soft" href="/">Home</a>
      </div>
    </div>
    <div class="nf-art" data-cat="surface-home-cleaners" set:html={`<svg viewBox="0 0 240 240" aria-hidden="true" focusable="false">${shapes.spray}</svg>`} />
  </section>
</BaseLayout>
