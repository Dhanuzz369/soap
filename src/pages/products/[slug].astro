---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero, { type HeroMedia } from '../../components/PageHero.astro';
import SpecTable from '../../components/SpecTable.astro';
import AnswerWall from '../../components/AnswerWall.astro';
import GuideRows from '../../components/GuideRows.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getRelated, type ProductEntry } from '../../lib/products';
import { getPosts, type BlogEntry } from '../../lib/blog';
import { productJsonLd, faqJsonLd, absoluteUrl } from '../../lib/seo';
import { productImagePath, productPicture } from '../../lib/product-image';
import { shapeFor } from '../../lib/pack-shapes';
import { splitName } from '../../lib/heading';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const cats = await getCollection('categories');
  const posts = await getPosts();
  return Promise.all(
    products.map(async (product) => ({
      params: { slug: product.data.slug },
      props: {
        product,
        category: cats.find((c) => c.id === product.data.category.id)!,
        related: await getRelated(product, 3),
        guides: posts.filter((p) => p.data.relatedProducts.includes(product.data.slug)),
      },
    })),
  );
}

interface Props {
  product: ProductEntry;
  category: { data: { title: string; slug: string } };
  related: ProductEntry[];
  guides: BlogEntry[];
}
const { product, category, related, guides } = Astro.props;
const d = product.data;
const { Content } = await render(product);
const url = `/products/${d.slug}/`;
const catId = d.category.id;
// A photo in public/images/products/<slug>.webp is used for social previews and JSON-LD.
const image = d.image ?? productImagePath(d.slug);
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: category.data.title, url: `/categories/${category.data.slug}/` },
  { name: d.title, url: url },
];
const name = splitName(d.title);
const pic = productPicture(d.slug, shapeFor(d.slug, catId), catId);
const media: HeroMedia | undefined = pic
  ? pic.kind === 'photo'
    ? { src: pic.src, width: pic.width, height: pic.height, alt: d.title, mode: 'card' }
    : {
        src: pic.src,
        srcset: pic.srcset,
        sizes: '(max-width: 759px) 100vw, 54vw',
        width: pic.width,
        height: pic.height,
        alt: `Illustration of ${d.title.toLowerCase()} in a typical export pack`,
        mode: 'bleed',
        cutout: true,
      }
  : undefined;
---

<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  path={url}
  ogImage={image}
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd({ ...d, category: category.data.title, image }, absoluteUrl(url)), faqJsonLd(d.faqs)]}
  dark
>
  <PageHero breadcrumbs={breadcrumbs} l1={name.l1} sub={name.sub} l2="Exporter & Supplier from India" scale={name.scale} lead={d.answer} media={media} size="product">
    <p class="ph-hsn">
      <span class="pill"><abbr title="Harmonized System of Nomenclature">HSN</abbr>&nbsp;{d.hsn}</span>
      <span>{d.hsnNote ? 'Alternative classification noted below' : '8-digit ITC-HS code confirmed per order'}</span>
    </p>
    <div class="ph-actions">
      <a class="btn btn--light" href={`/contact/?product=${d.slug}`}>Request a Quote</a>
      <a class="link-arrow" href="#faq">Read the FAQ <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </PageHero>

  <section class="wrap sec" aria-labelledby="facts-h">
    <div class="sec-head" data-reveal>
      <h2 id="facts-h">Key facts for buyers</h2>
    </div>
    <dl class="facts" data-reveal style="--i: 1">
      <div>
        <dt>HSN code</dt>
        <dd>
          {d.hsn}
          <p class="note">{d.hsnNote ?? 'The 8-digit ITC-HS code is confirmed per order.'}</p>
        </dd>
      </div>
      <div>
        <dt>Minimum order quantity</dt>
        <dd>{d.moq}</dd>
      </div>
      <div>
        <dt>Private label</dt>
        <dd>
          {d.privateLabel.available ? 'Available.' : 'Not offered for this product.'}
          {d.privateLabel.available && d.privateLabel.options.length > 0 && <span> {d.privateLabel.options.join('; ')}.</span>}
        </dd>
      </div>
    </dl>
  </section>

  <section class="wrap sec" aria-labelledby="var-h">
    <div class="sec-head" data-reveal>
      <h2 id="var-h">Varieties, pack sizes and packaging</h2>
    </div>
    <div class="chip-groups">
      <div data-reveal>
        <h3>Available varieties</h3>
        <ul class="chips chips--lg" aria-label="Varieties">
          {d.variants.map((v) => <li class="chip">{v}</li>)}
        </ul>
      </div>
      <div data-reveal style="--i: 1">
        <h3>Pack sizes</h3>
        <ul class="chips chips--lg" aria-label="Pack sizes">
          {d.packSizes.map((v) => <li class="chip">{v}</li>)}
        </ul>
      </div>
      <div data-reveal style="--i: 2">
        <h3>Packaging options</h3>
        <ul class="plain-list">
          {d.packaging.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap sec split" aria-labelledby="spec-h">
    <div class="split-head" data-reveal>
      <h2 id="spec-h">What are the typical specifications?</h2>
      <p class="note">{d.title}: typical values for export grades. Final values are confirmed with the manufacturer per order.</p>
    </div>
    <div data-reveal style="--i: 1">
      <SpecTable specs={d.specs} />
    </div>
  </section>

  <section class="wrap sec post-layout" aria-label={`About ${d.title}`}>
    <div class="prose"><Content /></div>
  </section>

  {
    d.containerLoad && (
      <section class="wrap sec" aria-labelledby="load-h">
        <div class="sec-head" data-reveal>
          <div>
            <h2 id="load-h">Container loading (approx.)</h2>
            <p>Approximate figures; the final loading plan is confirmed per order.</p>
          </div>
        </div>
        <dl class="facts facts--two" data-reveal style="--i: 1">
          <div>
            <dt>20 ft container</dt>
            <dd>{d.containerLoad.ft20}</dd>
          </div>
          <div>
            <dt>40 ft container</dt>
            <dd>{d.containerLoad.ft40}</dd>
          </div>
        </dl>
      </section>
    )
  }

  <AnswerWall faqs={d.faqs} heading="Straight answers." id="faq" />

  {guides.length > 0 && <GuideRows posts={guides} heading="Buyer guides for this product" id="guides" />}

  {
    related.length > 0 && (
      <section class="wrap sec" aria-labelledby="rel-h">
        <div class="sec-head" data-reveal>
          <h2 id="rel-h">Related products</h2>
          <a class="link-arrow" href={`/categories/${category.data.slug}/`}>
            All {category.data.title.toLowerCase()} <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
        <CardGrid products={related} details={false} />
      </section>
    )
  }

  <QuoteCard
    heading="Quote this product."
    text={`Tell us the ${d.title.toLowerCase()} variety, pack size, quantity and destination port in one line. The enquiry form opens with it written in.`}
    product={d.slug}
  />
</BaseLayout>
