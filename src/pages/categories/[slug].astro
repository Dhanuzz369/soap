---
import { categoryPicture } from '../../lib/product-image';
import { getProductsByCategory, type CategoryEntry, type ProductEntry } from '../../lib/products';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CardGrid from '../../components/CardGrid.astro';
import AnswerWall from '../../components/AnswerWall.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { faqJsonLd } from '../../lib/seo';
import { splitName } from '../../lib/heading';

export async function getStaticPaths() {
  const groups = await getProductsByCategory();
  return groups.map((g) => ({
    params: { slug: g.category.data.slug },
    props: { category: g.category, products: g.products },
  }));
}

interface Props {
  category: CategoryEntry;
  products: ProductEntry[];
}
const { category, products } = Astro.props;
const c = category.data;
const url = `/categories/${c.slug}/`;
const faqs = products.slice(0, 6).map((p) => p.data.faqs[0]).filter((f) => !!f);
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: c.title, url },
];
// Category group renders (npm run renders): sizes as made by scripts/render-packs.mjs.
const dims: Record<string, [number, number]> = {
  'bath-personal-soaps': [1440, 1200],
  'industrial-raw-materials': [760, 1200],
};
const [w, h] = dims[c.slug] ?? [1000, 800];
const cpic = categoryPicture(c.slug);
const name = splitName(c.title);
---

<BaseLayout
  title={`${c.title} Exporter & Supplier from India`}
  description={c.summary}
  path={url}
  breadcrumbs={breadcrumbs}
  jsonLd={faqs.length ? [faqJsonLd(faqs)] : []}
  dark
>
  <PageHero
    breadcrumbs={breadcrumbs}
    l1={name.l1}
    l2="Exporter & Supplier from India"
    scale={name.scale}
    lead={c.summary}
    size="product"
    media={cpic.kind === 'photo' ? {
      src: cpic.src,
      srcset: cpic.srcset,
      sizes: '(max-width: 759px) 100vw, 44vw',
      width: cpic.width,
      height: cpic.height,
      alt: `${c.title} from GoodBiz`,
      mode: 'card',
    } : {
      src: `/images/renders/category-${c.slug}.webp`,
      width: w,
      height: h,
      alt: `Illustration of typical ${c.title.toLowerCase()} packs`,
      mode: 'bleed',
      cutout: true,
    }}
  >
    <p class="ph-hsn">
      <span class="pill">HSN {c.hsnRange}</span>
      <span>{products.length} products · 8-digit ITC-HS code confirmed per order</span>
    </p>
    <div class="ph-actions">
      <a class="btn btn--light" href="/contact/">Request a Quote</a>
      <a class="link-arrow" href="#cat-products">See the {products.length} products <span class="arr" aria-hidden="true">↓</span></a>
    </div>
  </PageHero>

  <section class="wrap sec" id="cat-products" aria-labelledby="cat-products-h">
    <div class="sec-head" data-reveal>
      <div>
        <h2 id="cat-products-h">Which {c.title.toLowerCase()} products do we supply?</h2>
        <p>{c.intro}</p>
      </div>
    </div>
    <CardGrid products={products} />
  </section>

  {faqs.length > 0 && <AnswerWall faqs={faqs} heading="Straight answers." id="faq" />}

  <QuoteCard heading={`Quote ${c.title.toLowerCase()}.`} />
</BaseLayout>
