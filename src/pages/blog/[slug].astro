---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero, { type HeroMedia } from '../../components/PageHero.astro';
import CardGrid from '../../components/CardGrid.astro';
import Faq from '../../components/Faq.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import { render, getCollection } from 'astro:content';
import { getPosts, readingMinutes, fmtDate, type BlogEntry } from '../../lib/blog';
import { articleJsonLd, faqJsonLd } from '../../lib/seo';
import { splitPostTitle } from '../../lib/heading';
import { productPicture } from '../../lib/product-image';
import { shapeFor } from '../../lib/pack-shapes';

export async function getStaticPaths() {
  const posts = await getPosts();
  const products = await getCollection('products');
  return posts.map((post) => {
    const related = post.data.relatedProducts
      .map((s) => products.find((p) => p.data.slug === s))
      .filter((p): p is NonNullable<typeof p> => !!p);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

interface Props {
  post: BlogEntry;
  related: Awaited<ReturnType<typeof getCollection<'products'>>>;
}
const { post, related } = Astro.props;
const d = post.data;
const url = `/blog/${post.id}/`;
const { Content } = await render(post);
const faqs = d.faqs ?? [];
const iso = d.date.toISOString().slice(0, 10);
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: d.title, url },
];
const t = splitPostTitle(d.title);
const lead = related[0];
const pic = lead ? productPicture(lead.data.slug, shapeFor(lead.data.slug, lead.data.category.id), lead.data.category.id) : undefined;
const media: HeroMedia | undefined =
  pic && pic.kind === 'render'
    ? {
        src: pic.src,
        srcset: pic.srcset,
        sizes: '(max-width: 759px) 100vw, 54vw',
        width: pic.width,
        height: pic.height,
        alt: `Illustration of ${lead!.data.title.toLowerCase()} in a typical export pack`,
        mode: 'bleed',
      }
    : undefined;
---

<BaseLayout
  title={d.title}
  description={d.description}
  path={url}
  breadcrumbs={breadcrumbs}
  jsonLd={[
    { ...articleJsonLd({ title: d.title, description: d.description, date: d.date, url, type: 'BlogPosting' }), ...(d.updated ? { dateModified: d.updated.toISOString() } : {}) },
    ...(faqs.length ? [faqJsonLd(faqs)] : []),
  ]}
  dark
>
  <PageHero breadcrumbs={breadcrumbs} l1={t.l1} l2={t.l2} size="post" media={media}>
    <p class="ph-meta">
      <time datetime={iso}>{fmtDate(d.date)}</time> · {readingMinutes(post.body ?? '')} min read · GoodBiz Hygiene
    </p>
    <p class="ph-lead">{d.description}</p>
  </PageHero>

  <div class="wrap sec post-layout">
    <article class="prose post-body">
      <Content />
    </article>
  </div>

  {faqs.length > 0 && <Faq faqs={faqs} heading="Quick answers" id="post-faq" split />}

  {
    related.length > 0 && (
      <section class="wrap sec" aria-labelledby="rel-h">
        <div class="sec-head" data-reveal>
          <h2 id="rel-h">Products mentioned in this guide</h2>
          <a class="link-arrow" href="/blog/">
            All guides <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
        <CardGrid products={related} />
      </section>
    )
  }

  <QuoteCard heading="Planning an order?" text="Tell us what you need in one line. The enquiry form opens with it written in, ready for your products, quantity and port." />
</BaseLayout>
