---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/floria.css';
import '../styles/i18n.css';
import site from '../config/site';
import { launched } from '../lib/launch';
import { lastmodFor } from '../lib/lastmod';
import { absoluteUrl, pageTitle, homeTitle, organizationJsonLd, websiteJsonLd, breadcrumbJsonLd, webPageJsonLd, MAX_KEYWORDS, type PageType } from '../lib/seo';
import { publicImageSize } from '../lib/product-image';
import { LOCALES, LOCALE_CODES, DEFAULT_LOCALE, alternates, localizePath } from '../i18n/locales';
import { pickLocale, isBot } from '../i18n/detect';
import { useI18n } from '../i18n/page';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import LangSwitch from '../components/LangSwitch.astro';

interface Props {
  title: string;
  description: string;
  /** The page's ENGLISH (unprefixed) path, e.g. '/products/labsa/'. The layout localizes it. */
  path: string;
  /** The share image (og:image, twitter:image): a 1200 × 630 card or a product photo. */
  ogImage?: string;
  /** Alt text of the share image (defaults to the page title). */
  ogImageAlt?: string;
  /** <meta name="keywords">: at most 12 phrases (src/lib/seo.ts buildKeywords). */
  keywords?: string[];
  /** The schema.org type of this page (WebPage block) and the @id of its main entity. */
  pageType?: PageType;
  mainEntity?: string;
  /** Blog posts: og:type article with its dates and tags. */
  article?: { published: Date; modified?: Date; tags?: string[] };
  /** When the page's facts were last checked (WebPage dateModified), for pages that are not articles. */
  dateModified?: Date;
  jsonLd?: object[];
  /** Breadcrumbs with names in the page's language and localized URLs. */
  breadcrumbs?: { name: string; url: string }[];
  /** Always noindex this page and leave out the canonical/hreflang links (e.g. the 404 page). */
  noindex?: boolean;
  /**
   * The page opens on a dark field (home hero, PageHero bands): the header starts light-on-dark, the
   * main area runs under it, and the page's band shows the breadcrumbs itself.
   */
  dark?: boolean;
  /** Extra <link rel="preload"> for the first screen's image (the LCP element). */
  preloadImage?: { href: string; type?: string; srcset?: string; sizes?: string };
  /** A second skip link after "Skip to content", to the page's main task (e.g. the enquiry form). */
  skipTo?: { href: string; label: string };
}

const {
  title,
  description,
  path,
  ogImage = '/og-default.png',
  ogImageAlt,
  keywords = [],
  pageType,
  mainEntity,
  article,
  dateModified,
  jsonLd = [],
  breadcrumbs,
  noindex = false,
  dark = false,
  preloadImage,
  skipTo,
} = Astro.props;
const { lang, info, ui } = useI18n(Astro.url);

const fullTitle = path === '/' ? homeTitle(title) : pageTitle(title);
const canonical = absoluteUrl(localizePath(path, lang));
// When the page last changed: the article's dates, the facts' review date, else the last commit
// that touched the page's sources (the same date as its sitemap <lastmod>, src/lib/lastmod.ts).
const fromGit = lastmodFor(canonical);
const modified = article?.modified ?? article?.published ?? dateModified ?? (fromGit ? new Date(fromGit) : undefined);
const feed = absoluteUrl(lang === DEFAULT_LOCALE ? '/rss.xml' : `/${lang}/rss.xml`);
const home = localizePath('/', lang);
const alts = alternates(path).map((a) => ({ ...a, href: absoluteUrl(a.path) }));
const ogUrl = absoluteUrl(ogImage);
const ogSize = publicImageSize(ogImage);
const ogType = /\.png$/.test(ogImage) ? 'image/png' : /\.jpe?g$/.test(ogImage) ? 'image/jpeg' : /\.webp$/.test(ogImage) ? 'image/webp' : undefined;
const kw = keywords.slice(0, MAX_KEYWORDS).join(', ');
const v = site.verification;
const hasCrumbs = !!breadcrumbs && breadcrumbs.length > 1;
const schemas: object[] = [
  organizationJsonLd(ui.seo.entity),
  websiteJsonLd({ url: absoluteUrl(home), inLanguage: info.hreflang, description: ui.meta.tagline }),
  ...(noindex
    ? []
    : [
        webPageJsonLd({
          url: localizePath(path, lang),
          name: fullTitle,
          description,
          inLanguage: info.hreflang,
          homeUrl: home,
          type: pageType,
          image: ogImage,
          breadcrumb: hasCrumbs,
          mainEntity,
          dateModified: modified,
        }),
      ]),
  ...(hasCrumbs ? [breadcrumbJsonLd(breadcrumbs!)] : []),
  ...jsonLd,
];
// Escape "<" so JSON-LD can never close the script element early.
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');

// Auto-detect (English, unprefixed pages only; never the 404): send a first-time visitor whose
// browser prefers a supported language to the same page in that language. Skipped for bots and
// when the visitor has chosen a language in the menu (localStorage "gb-lang").
const detect =
  lang === DEFAULT_LOCALE && !noindex
    ? `(function(){try{if(localStorage.getItem('gb-lang'))return}catch(e){return}` +
      `var isBot=(${isBot.toString()});var pick=(${pickLocale.toString()});` +
      `if(isBot(navigator.userAgent))return;` +
      `var l=pick(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||''],${JSON.stringify(LOCALE_CODES)},'en');` +
      `if(l!=='en')location.replace('/'+l+location.pathname+location.search+location.hash)})();`
    : '';
const ar = lang === 'ar';
---

<!doctype html>
<html lang={info.hreflang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {detect && <script is:inline set:html={detect} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {kw && <meta name="keywords" content={kw} />}
    {(noindex || !launched) && <meta name="robots" content="noindex, nofollow" />}
    {
      // Large image previews and full snippets in Google once the site is live (src/lib/launch.ts:
      // launchReady AND a production build, so Vercel previews stay noindex).
      !noindex && launched && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }
    {v.google && <meta name="google-site-verification" content={v.google} />}
    {v.bing && <meta name="msvalidate.01" content={v.bing} />}
    {v.yandex && <meta name="yandex-verification" content={v.yandex} />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={dark ? '#0b211a' : '#f5f8f2'} />
    <meta name="application-name" content={site.name} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={absoluteUrl(lang === DEFAULT_LOCALE ? '/llms.txt' : `/${lang}/llms.txt`)} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: ${ui.blogIndex.title}`} href={feed} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogUrl.startsWith('https://') && <meta property="og:image:secure_url" content={ogUrl} />}
    {ogType && <meta property="og:image:type" content={ogType} />}
    {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
    <meta property="og:image:alt" content={ogImageAlt ?? fullTitle} />
    <meta property="og:locale" content={info.og} />
    {LOCALES.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
          {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    {!article && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? fullTitle} />

    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {
      ar ? (
        // Body weight only: a second preload competed with the hero image for bandwidth (Lighthouse).
        <link rel="preload" href="/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      ) : (
        lang !== 'zh' && <link rel="preload" href="/fonts/newsreader-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage.href}
          as="image"
          type={preloadImage.type ?? 'image/webp'}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    {schemas.map((s) => <script type="application/ld+json" set:html={ld(s)} />)}
    <slot name="head" />
  </head>
  <body id="top" class:list={{ 'page-dark': dark }}>
    <a class="skip" href="#main">{ui.common.skip}</a>
    {skipTo && <a class="skip" href={skipTo.href}>{skipTo.label}</a>}
    <Header path={path} tone={dark ? 'dark' : 'light'} />
    <main id="main">
      {!dark && breadcrumbs && breadcrumbs.length > 1 && (
        <div class="wrap crumbs-wrap"><Breadcrumbs items={breadcrumbs} /></div>
      )}
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <LangSwitch path={path} homesOnly={noindex} />
    <script is:inline>
      // Scroll reveal: only blocks still below the fold are held back, so nothing on the first
      // screen flickers, and without JS (or with reduced motion) everything is simply visible.
      // [data-step] items are marked .is-lit as they reach the middle of the screen.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var lit = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-lit');
                lit.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -35% 0px' },
        );
        document.querySelectorAll('[data-step]').forEach(function (el) {
          lit.observe(el);
        });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll('[data-reveal]');
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.remove('is-pending');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach(function (el) {
          if (el.getBoundingClientRect().top > innerHeight * 0.9) {
            el.classList.add('is-pending');
            io.observe(el);
          }
        });
      })();
    </script>
  </body>
</html>
